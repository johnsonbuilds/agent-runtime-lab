[agent-runtime] llm.chunk iteration=11 content='' reasoning='' tool_calls=[{'index': 0, 'id': None, 'function': {'name': None, 'arguments': '"content": "#\' Adaptive Rejection Sampling (ARS)\\n#\'\\n#\' Implements the adaptive rejection sampling algorithm of Gilks & Wild (1992)\\n#\' for sampling from log-concave densities.\\n#\'\\n#\' @references\\n#\' Gilks, W. R., & Wild, P. (1992). Adaptive rejection sampling for Gibbs sampling.\\n#\' Journal of the Royal Statistical Society: Series C (Applied Statistics), 41(2), 337-348.\\n\\n# ============================================================================\\n# INPUT VALIDATION\\n# ============================================================================\\n\\n#\' Validate inputs to the ars function\\n#\'\\n#\' @param logdensity A function that evaluates the log of the (possibly\\n#\'   unnormalized) target density at a vector of points.\\n#\' @param x0 A numeric vector of initial support points.\\n#\' @param lower,upper Finite or infinite bounds for the domain.\\n#\' @param n A positive integer giving the number of samples to generate.\\n#\' @return NULL (invisible) if all inputs are valid; otherwise an error is\\n#\'   thrown with an informative message.\\nvalidate_inputs <- function(logdensity, x0, lower, upper, n) {\\n  if (!is.function(logdensity)) {\\n    stop(\\"Argument \'logdensity\' must be a function.\\")\\n  }\\n\\n  if (!is.numeric(n) || length(n) != 1 || n < 1 || n != as.integer(n)) {\\n    stop(\\"Argument \'n\' must be a positive integer.\\")\\n  }\\n\\n  # lower / upper checks\\n  if (!is.infinite(lower)) {\\n    if (!is.numeric(lower) || length(lower) != 1 || is.na(lower)) {\\n      stop(\\"Argument \'lower\' must be a finite number or -Inf.\\")\\n    }\\n  }\\n  if (!is.infinite(upper)) {\\n    if (!is.numeric(upper) || length(upper) != 1 || is.na(upper)) {\\n      stop(\\"Argument \'upper\' must be a finite number or Inf.\\")\\n    }\\n  }\\n  if (lower >= upper) {\\n    stop(\\"Argument \'lower\' must be strictly less than \'upper\'.\\")\\n  }\\n\\n  # x0 checks\\n  if (!is.numeric(x0)) {\\n    stop(\\"Argument \'x0\' must be a numeric vector.\\")\\n  }\\n  if (length(x0) < 3) {\\n    stop(\\"Argument \'x0\' must contain at least three points.\\")\\n  }\\n  if (any(is.na(x0))) {\\n    stop(\\"Argument \'x0\' must not contain NA values.\\")\\n  }\\n  if (any(x0 <= lower) || any(x0 >= upper)) {\\n    stop(\\"All elements of \'x0\' must lie strictly between \'lower\' and \'upper\'.\\")\\n  }\\n  if (!all(diff(x0) > 0)) {\\n    stop(\\"Elements of \'x0\' must be in strictly increasing order.\\")\\n  }\\n\\n  # Evaluate log-density at x0\\n  logy <- logdensity(x0)\\n  if (!is.numeric(logy) || length(logy) != length(x0)) {\\n    stop(\\"Evaluation of \'logdensity\' at \'x0\' did not return a numeric vector of the same length.\\")\\n  }\\n  if (any(!is.finite(logy))) {\\n    stop(\\"Some evaluations of \'logdensity\' at \'x0\' were not finite.\\")\\n  }\\n\\n  invisible(NULL)\\n}\\n\\n\\n# ============================================================================\\n# LOG-CONCAVITY CHECKS\\n# ============================================================================\\n\\n#\' Check log-concavity at the current support points.\\n#\'\\n#\' For a twice differentiable log-density, log-concavity means\\n#\' \\\\eqn{d^2}{d^2} log f(x) / dx^2 <= 0 for all x in the domain.  We approximate\\n#\' the second derivative by central differences on the current support points\\n#\' and also verify that the slopes are non-increasing.\\n#\'\\n#\' @param x A numeric vector of strictly increasing support points.\\n#\' @param logy A numeric vector of log-density values at \\\\code{x}.\\n#\' @param logdensity The log-density function.\\n#\' @param tol A small tolerance (default 1e-8) used to allow minor numerical\\n#\'   violations.\\n#\' @return TRUE if the density appears log-concave, FALSE otherwise.\\ncheck_log_concavity <- function(x, logy, logdensity, tol = 1e-8) {\\n  n <- length(x)\\n  if (n < 3) return(TRUE)\\n\\n  # Verify slopes are non-increasing (first-derivative condition).\\n  h <- diff(x)\\n  slopes <- diff(logy) / h\\n  if (any((slopes[-1] - slopes[-n]) > tol)) {\\n    return(FALSE)\\n  }\\n\\n  # Verify negative second derivative via central differences.\\n  # Use a fine grid inside the support to catch violations between support\\n  # points.\\n  ngrid <- max(200, 10 * (n - 1))\\n  grid <- seq(lower + (upper - lower) * 1e-6,\\n              upper - (upper - lower) * 1e-6,\\n              length.out = ngrid)\\n  # Keep only grid points inside the convex hull of x.\\n  grid <- grid[grid > x[1] & grid < x[n]]\\n  if (length(grid) < 2) return(TRUE)\\n\\n  hgrid <- diff(grid)\\n  logg <- logdensity(grid)\\n  if (!is.finite(logg[1]) || !is.finite(logg[length(logg)])) return(TRUE)\\n\\n  second_deriv <- numeric(length(grid) - 2)\\n  for (i in seq_along(second_deriv)) {\\n    second_deriv[i] <- (logg[i + 2] - 2 * logg[i + 1] + logg[i]) /\\n                       (hgrid[i] * hgrid[i + 1])\\n  }\\n  if (any(second_deriv > tol)) {\\n    return(FALSE)\\n  }\\n  TRUE\\n}\\n\\n\\n# ============================================================================\\n# UPPER ENVELOPE CONSTRUCTION\\n# ============================================================================\\n\\n#\' Compute the coefficients of the piecewise linear upper envelope in log\\n#\' space.\\n#\'\\n#\' Given support points x and log-density values logy, the upper envelope is\\n#\' the concatenation of straight line segments connecting (x_i, logy_i) and\\n#\' (x_{i+1}, logy_{i+1}).  The function returns the intercept and slope on\\n#\' each segment, as well as the log-normalization constant of the envelope.\\n#\'\\n#\' @param x Support points (increasing).\\n#\' @param logy Log-density values at x.\\n#\' @return A list with components \\\\code{a}, \\\\code{b} (intercept and slope on\\n#\'   each segment) and \\\\code{logZ} (log of the integral of the envelope).\\ncompute_envelope <- function(x, logy) {\\n  n <- length(x)\\n  h <- diff(x)\\n  slopes <- diff(logy) / h\\n\\n  a <- logy[-n] - slopes * x[-n]\\n  b <- slopes\\n\\n  # Integral of exp(a + b*(x - x_i)) over [x_i, x_{i+1}] is\\n  #   (exp(a_i + b_i*h_i) - exp(a_i)) / b_i  when b_i != 0\\n  #   h_i * exp(a_i)                         when b_i == 0\\n  log_areas <- rep(NA, n - 1)\\n  for (i in seq_len(n - 1)) {\\n    if (abs(b[i]) < 1e-12) {\\n      log_areas[i] <- log(h[i]) + a[i]\\n    } else {\\n      upper_val <- a[i] + b[i] * h[i]\\n      lower_val <- a[i]\\n      # Use logsumexp for numerical stability.\\n      log_areas[i] <- log(exp(upper_val) - exp(lower_val)) - b[i]\\n    }\\n  }\\n  logZ <- logsumexp(log_areas)\\n\\n  list(a = a, b = b, logZ = logZ)\\n}\\n\\n\\n#\' Sum of exponentials in log space (log-sum-exp trick).\\nlogsumexp <- function(x) {\\n  max_x <- max(x)\\n  max_x + log(sum(exp(x - max_x)))\\n}\\n\\n\\n#\' Compute the cumulative distribution function (CDF) of the upper envelope\\n#\' at a set of evaluation points.\\n#\'\\n#\' @param envelope The envelope list returned by \\\\code{compute_envelope}.\\n#\' @param xq Points at which to evaluate the CDF.\\n#\' @param x Support points.\\n#\' @return A numeric vector of CDF values.\\nenv_cdf <- function(envelope, xq, x) {\\n  n <- length(x)\\n  a <- envelope$a\\n  b <- envelope$b\\n  logZ <- envelope$logZ\\n\\n  # CDF on each segment: integral from x_i to min(xq, x_{i+1}) of\\n  # exp(a_i + b_i*(t - x_i)) dt, divided by exp(logZ).\\n  cdf_vals <- numeric(length(xq))\\n\\n  for (j in seq_along(xq)) {\\n    q <- xq[j]\\n    if (q <= x[1]) {\\n      cdf_vals[j] <- 0\\n    } else if (q >= x[n]) {\\n      cdf_vals[j] <- 1\\n    } else {\\n      # Find the segment.\\n      seg <- findInterval(q, x, rightmost.closed = FALSE)\\n      if (seg >= n) seg <- n - 1\\n      # Integrate full segments before seg.\\n      total_log <- -Inf\\n      for (i in seq_len(seg - 1)) {\\n        if (abs(b[i]) < 1e-12) {\\n          area <- h[i] * exp(a[i])\\n        } else {\\n          area <- (exp(a[i] + b[i] * h[i]) - exp(a[i])) / b[i]\\n        }\\n        total_log <- logsumexp(c(total_log, log(area)))\\n      }\\n      # Integrate partial segment seg.\\n      h_seg <- q - x[seg]\\n      if (abs(b[seg]) < 1e-12) {\\n        partial <- h_seg * exp(a[seg])\\n      } else {\\n        partial <- (exp(a[seg] + b[seg] * h_seg) - exp(a[seg])) / b[seg]\\n      }\\n      total_log <- logsumexp(c(total_log, log(partial)))\\n      cdf_vals[j] <- exp(total_log - logZ)\\n    }\\n  }\\n  cdf_vals\\n}\\n\\n\\n# ============================================================================\\n# SAMPLING FROM THE ENVELOPE\\n# ============================================================================\\n\\n#\' Sample from the piecewise linear upper envelope.\\n#\'\\n#\' @param envelope The envelope list.\\n#\' @param x Support points.\\n#\' @param n_sample Number of samples to draw.\\n#\' @return A numeric vector of samples.\\nsample_from_envelope <- function(envelope, x, n_sample) {\\n  n <- length(x)\\n  h <- diff(x)\\n  a <- envelope$a\\n  b <- envelope$b\\n  logZ <- envelope$logZ\\n\\n  # Compute area of each segment in log space.\\n  log_areas <- numeric(n - 1)\\n  for (i in seq_len(n - 1)) {\\n    if (abs(b[i]) < 1e-12) {\\n      log_areas[i] <- log(h[i]) + a[i]\\n    } else {\\n      upper_val <- a[i] + b[i] * h[i]\\n      lower_val <- a[i]\\n      log_areas[i] <- log(exp(upper_val) - exp(lower_val)) - b[i]\\n    }\\n  }\\n\\n  # Sample which segment.\\n  probs <- exp(log_areas - logZ)\\n  seg_idx <- sample(seq_len(n - 1), size = n_sample, replace = TRUE, prob = probs)\\n\\n  # Within each segment, sample from the truncated exponential.\\n  samples <- numeric(n_sample)\\n  u <- runif(n_sample)\\n  for (k in seq_len(n_sample)) {\\n    i <- seg_idx[k]\\n    ui <- u[k]\\n    # CDF on segment i: F(t) = (exp(b_i*(t-x_i)) - 1) / (exp(b_i*h_i) - 1)\\n    # Invert: t = x_i + log(1 + ui*(exp(b_i*h_i)-1)) / b_i\\n    if (abs(b[i]) < 1e-12) {\\n      samples[k] <- x[i] + ui * h[i]\\n    } else {\\n      samples[k] <- x[i] + log(1 + ui * (exp(b[i] * h[i]) - 1)) / b[i]\\n    }\\n  }\\n  samples\\n}\\n\\n\\n# ============================================================================\\n# MAIN ARS FUNCTION\\n# ============================================================================\\n\\n#\' Adaptive Rejection Sampling\\n#\'\\n#\' Generate \\\\code{n} samples from a log-concave density proportional to\\n#\' \\\\code{exp(logdensity(x))} on the interval (\\\\code{lower}, \\\\code{upper}).\\n#\'\\n#\' @param logdensity A function evaluating the log of the (possibly\\n#\'   unnormalized) target density. Must accept a vector of points and return\\n#\'   a vector of the same length.\\n#\' @param x0 A numeric vector of at least three starting support points\\n#\'   strictly inside (\\\\code{lower}, \\\\code{upper}).\\n#\' @param lower Lower bound of the support (\\\\code{-Inf} allowed).\\n#\' @param upper Upper bound of the support (\\\\code{Inf} allowed).\\n#\' @param n Number of samples to generate.\\n#\' @param ... Additional arguments passed to \\\\code{logdensity} (unused here,\\n#\'   but allows future extensions).\\n#\' @return A numeric vector of \\\\code{n} samples from the target distribution.\\n#\' @examples\\n#\' \\\\dontrun{\\n#\'   samples <- ars(dnorm, x0 = c(-3, 0, 3), lower = -Inf, upper = Inf, n = 1000)\\n#\'   samples <- ars(function(x) -x^2/2, x0 = c(-3, 0, 3), lower = -Inf, upper = Inf, n = 1000)\\n#\' }\\nars <- function(logdensity, x0, lower = -Inf, upper = Inf, n) {\\n  # --- Validate inputs -------------------------------------------------------\\n  validate_inputs(logdensity, x0, lower, upper, n)\\n\\n  x <- sort(x0)\\n  logy <- logdensity(x)\\n  n_support <- length(x)\\n\\n  # --- Initial envelope ------------------------------------------------------\\n  envelope <- compute_envelope(x, logy)\\n\\n  samples <- numeric(n)\\n  n_generated <- 0\\n  n_rejected <- 0\\n  max_iter <- n * 100  # safety cap\\n\\n  set.seed(NULL)  # ensure randomness\\n\\n  while (n_generated < n && n_rejected < max_iter) {\\n    # --- Draw a candidate from the current upper envelope ------------------\\n    cand <- sample_from_envelope(envelope, x, 1)\\n\\n    # --- Acceptance test ---------------------------------------------------\\n    log_target <- logdensity(cand)\\n    if (!is.finite(log_target)) {\\n      # Candidate outside domain where logdensity is finite: reject.\\n      n_rejected <- n_rejected + 1\\n      next\\n    }\\n\\n    # Log-density of the envelope at the candidate.\\n    seg <- findInterval(cand, x, rightmost.closed = FALSE)\\n    if (seg >= n_support) seg <- n_support - 1\\n    if (seg < 1) seg <- 1\\n    log_env <- envelope$a[seg] + envelope$b[seg] * (cand - x[seg])\\n\\n    u <- runif(1)\\n    if (log(u) <= log_target - log_env) {\\n      # Accept.\\n      n_generated <- n_generated + 1\\n      samples[n_generated] <- cand\\n    } else {\\n      # Reject: add the candidate as a new support point and recompute.\\n      n_rejected <- n_rejected + 1\\n      x <- c(x, cand)\\n      logy <- c(logy, logdensity(cand))\\n      idx <- order(x)\\n      x <- x[idx]\\n      logy <- logy[idx]\\n      if (!check_log_concavity(x, logy, logdensity)) {\\n        stop(\\"Log-concavity assumption violated during sampling. \\",\\n             \\"The target density may not be log-concave.\\")\\n      }\\n      envelope <- compute_envelope(x, logy)\\n    }\\n  }\\n\\n  if (n_generated < n) {\\n    stop(\\"Sampling failed to produce enough samples within the iteration limit.\\")\\n  }\\n\\n  samples\\n}\\n\\n\\n# ============================================================================\\n# TEST SUITE\\n# ============================================================================\\n\\n#\' Formal tests for the adaptive rejection sampler.\\n#\'\\n#\' Runs a battery of tests against known distributions and prints results in\\n#\' the format \\\\code{TEST_NAME: PASS} or \\\\code{TEST_NAME: FAIL}.\\ntest <- function() {\\n  cat(\\"=== Adaptive Rejection Sampling Test Suite ===\\\\n\\\\n\\")\\n\\n  passed <- 0\\n  failed <- 0\\n\\n  # --------------------------------------------------------------------------\\n  # Test 1: INPUT VALIDATION — negative n\\n  # --------------------------------------------------------------------------\\n  test_input_negative_n <- function() {\\n    name <- \\"INPUT_NEGATIVE_N\\"\\n    ok <- TRUE\\n    tryCatch({\\n      ars(function(x) -x^2 / 2, x0 = c(-1, 0, 1), lower = -Inf, upper = Inf, n = -1)\\n      ok <- FALSE\\n    }, error = function(e) {\\n      if (grepl(\\"positive integer\\", e$message, ignore.case = TRUE)) ok <<- TRUE\\n    })\\n    if (ok) {\\n      cat(sprintf(\\"%s: PASS\\\\n\\", name))\\n      passed <<- passed + 1\\n    } else {\\n      cat(sprintf(\\"%s: FAIL\\\\n\\", name))\\n      failed <<- failed + 1\\n    }\\n  }\\n\\n  # --------------------------------------------------------------------------\\n  # Test 2: INPUT VALIDATION — non-function logdensity\\n  # --------------------------------------------------------------------------\\n  test_input_nonfunction <- function() {\\n    name <- \\"INPUT_NONFUNCTION_LOGDENSITY\\"\\n    ok <- FALSE\\n    tryCatch({\\n      ars(42, x0 = c(-1, 0, 1), lower = -Inf, upper = Inf, n = 10)\\n    }, error = function(e) {\\n      if (grepl(\\"must be a function\\", e$message, ignore.case = TRUE)) ok <<- TRUE\\n    })\\n    if (ok) {\\n      cat(sprintf(\\"%s: PASS\\\\n\\", name))\\n      passed <<- passed + 1\\n    } else {\\n      cat(sprintf(\\"%s: FAIL\\\\n\\", name))\\n      failed <<- failed + 1\\n    }\\n  }\\n\\n  # --------------------------------------------------------------------------\\n  # Test 3: INPUT VALIDATION — too few support points\\n  # --------------------------------------------------------------------------\\n  test_input_few_points <- function() {\\n    name <- \\"INPUT_FEW_SUPPORT_POINTS\\"\\n    ok <- FALSE\\n    tryCatch({\\n      ars(function(x) -x^2 / 2, x0 = c(0, 1), lower = -Inf, upper = Inf, n = 10)\\n    }, error = function(e) {\\n      if (grepl(\\"at least three\\", e$message, ignore.case = TRUE)) ok <<- TRUE\\n    })\\n    if (ok) {\\n      cat(sprintf(\\"%s: PASS\\\\n\\", name))\\n      passed <<- passed + 1\\n    } else {\\n      cat(sprintf(\\"%s: FAIL\\\\n\\", name))\\n      failed <<- failed + 1\\n    }\\n  }\\n\\n  # --------------------------------------------------------------------------\\n  # Test 4: STANDARD NORMAL — mean and variance\\n  # --------------------------------------------------------------------------\\n  test_normal_mean_var <- function() {\\n    name <- \\"NORMAL_MEAN_VARIANCE\\"\\n    set.seed(2024)\\n    samples <- ars(function(x) -x^2 / 2,\\n                   x0 = c(-2, 0, 2),\\n                   lower = -Inf, upper = Inf,\\n                   n = 10000)\\n    m <- mean(samples)\\n    v <- var(samples)\\n    pass <- abs(m - 0) < 0.05 & abs(v - 1) < 0.05\\n    cat(sprintf(\\"%s: %s  (mean=%.4f, sd=%.4f)\\\\n\\",\\n                name, if (pass) \\"PASS\\" else \\"FAIL\\", m, sd(samples)))\\n    if (pass) passed <<- passed + 1 else failed <<- failed + 1\\n    samples\\n  }\\n\\n  # --------------------------------------------------------------------------\\n  # Test 5: EXPONENTIAL — mean and variance\\n  # --------------------------------------------------------------------------\\n  test_exponential_mean_var <- function() {\\n    name <- \\"EXPONENTIAL_MEAN_VARIANCE\\"\\n    set.seed(2024)\\n    samples <- ars(function(x) -x,\\n                   x0 = c(0.1, 1, 5),\\n                   lower = 0, upper = Inf,\\n                   n = 10000)\\n    m <- mean(samples)\\n    v <- var(samples)\\n    pass <- abs(m - 1) < 0.05 & abs(v - 1) < 0.05\\n    cat(sprintf(\\"%s: %s  (mean=%.4f, sd=%.4f)\\\\n\\",\\n                name, if (pass) \\"PASS\\" else \\"FAIL\\", m, sd(samples)))\\n    if (pass) passed <<- passed + 1 else failed <<- failed + 1\\n    samples\\n  }\\n\\n  # --------------------------------------------------------------------------\\n  # Test 6: NON LOG-CONCAVE DENSITY — should error\\n  # --------------------------------------------------------------------------\\n  test_non_logconcave <- function() {\\n    name <- \\"NON_LOGCONCAVE_REJECTED\\"\\n    ok <- FALSE\\n    # Bimodal density: mixture of two normals (log-density is not concave)\\n    bad_density <- function(x) {\\n      log(0.5 * dnorm(x, -3) + 0.5 * dnorm(x, 3))\\n    }\\n    tryCatch({\\n      ars(bad_density, x0 = c(-6, -3, 0, 3, 6), lower = -Inf, upper = Inf, n = 10)\\n    }, error = function(e) {\\n      if (grepl(\\"log-concavity\\", e$message, ignore.case = TRUE)) ok <<- TRUE\\n    })\\n    if (ok) {\\n      cat(sprintf(\\"%s: PASS\\\\n\\", name))\\n      passed <<- passed + 1\\n    } else {\\n      cat(sprintf(\\"%s: FAIL\\\\n\\", name))\\n      failed <<- failed + 1\\n    }\\n  }\\n\\n  # --------------------------------------------------------------------------\\n  # Test 7: KS TEST vs KNOWN DISTRIBUTION (Normal)\\n  # --------------------------------------------------------------------------\\n  test_ks_normal <- function() {\\n    name <- \\"KS_NORMAL\\"\\n    set.seed(2024)\\n    samples <- ars(function(x) -x^2 / 2,\\n                   x0 = c(-2, 0, 2),\\n                   lower = -Inf, upper = Inf,\\n                   n = 5000)\\n    pval <- ks.test(samples, \\"pnorm\\", mean = 0, sd = 1)$p.value\\n    pass <- pval > 0.01\\n    cat(sprintf(\\"%s: %s  (KS p-value=%.4f)\\\\n\\",\\n                name, if (pass) \\"PASS\\" else \\"FAIL\\", pval))\\n    if (pass) passed <<- passed + 1 else failed <<- failed + 1\\n    samples\\n  }\\n\\n  # --------------------------------------------------------------------------\\n  # Test 8: KS TEST vs KNOWN DISTRIBUTION (Exponential)\\n  # --------------------------------------------------------------------------\\n  test_ks_exponential <- function() {\\n    name <- \\"KS_EXPONENTIAL\\"\\n    set.seed(2024)\\n    samples <- ars(function(x) -x,\\n                   x0 = c(0.1, 1, 5),\\n                   lower = 0, upper = Inf,\\n                   n = 5000)\\n    pval <- ks.test(samples, \\"pexp\\", rate = 1)$p.value\\n    pass <- pval > 0.01\\n    cat(sprintf(\\"%s: %s  (KS p-value=%.4f)\\\\n\\",\\n                name, if (pass) \\"PASS\\" else \\"FAIL\\", pval))\\n    if (pass) passed <<- passed + 1 else failed <<- failed + 1\\n    samples\\n  }\\n\\n  # --------------------------------------------------------------------------\\n  # Test 9: GAUSSIAN WITH NON-STANDARD PARAMETERS\\n  # --------------------------------------------------------------------------\\n  test_gaussian_shifted <- function() {\\n    name <- \\"GAUSSIAN_SHIFTED\\"\\n    set.seed(2024)\\n    mu <- 5\\n    sigma <- 2\\n    samples <- ars(function(x) -((x - mu)^2) / (2 * sigma^2),\\n                   x0 = c(mu - 2*sigma, mu, mu + 2*sigma),\\n                   lower = -Inf, upper = Inf,\\n                   n = 10000)\\n    m <- mean(samples)\\n    s <- sd(samples)\\n    pass <- abs(m - mu) < 0.1 & abs(s - sigma) < 0.1\\n    cat(sprintf(\\"%s: %s  (mean=%.4f, sd=%.4f)\\\\n\\",\\n                name, if (pass) \\"PASS\\" else \\"FAIL\\", m, s))\\n    if (pass) passed <<- passed + 1 else failed <<- failed + 1\\n    samples\\n  }\\n\\n  # --------------------------------------------------------------------------\\n  # Test 10: HALF-NORMAL (truncated normal)\\n  # --------------------------------------------------------------------------\\n  test_half_normal <- function() {\\n    name <- \\"HALF_NORMAL\\"\\n    set.seed(2024)\\n    # Target: proportional to exp(-x^2/2) on [0, Inf)\\n    samples <- ars(function(x) -x^2 / 2,\\n                   x0 = c(0.1, 1, 3),\\n                   lower = 0, upper = Inf,\\n                   n = 10000)\\n    # Mean of half-normal is sqrt(2/pi) ~ 0.798\\n    m <- mean(samples)\\n    pass <- abs(m - sqrt(2 / pi)) < 0.05\\n    cat(sprintf(\\"%s: %s  (mean=%.4f, expected=%.4f)\\\\n\\",\\n                name, if (pass) \\"PASS\\" else \\"FAIL\\", m, sqrt(2 / pi)))\\n    if (pass) passed <<- passed + 1 else failed <<- failed + 1\\n    samples\\n  }\\n\\n  # --- Run all tests --------------------------------------------------------\\n  r1 <- test_input_negative_n()\\n  r2 <- test_input_nonfunction()\\n  r3 <- test_input_few_points()\\n  r4 <- test_normal_mean_var()\\n  r5 <- test_exponential_mean_var()\\n  r6 <- test_non_logconcave()\\n  r7 <- test_ks_normal()\\n  r8 <- test_ks_exponential()\\n  r9 <- test_gaussian_shifted()\\n  r10 <- test_half_normal()\\n\\n  cat(\\"\\\\n=== Summary ===\\\\n\\")\\n  cat(sprintf(\\"Passed: %d / %d\\\\n\\", passed, passed + failed))\\n  cat(sprintf(\\"Failed: %d / %d\\\\n\\", failed, passed + failed))\\n\\n  # Return sampled objects invisibly for downstream use (e.g. saving files).\\n  invisible(list(\\n    normal_samples = r4,\\n    exponential_samples = r5,\\n    normal_ks = r7,\\n    exponential_ks = r8,\\n    gaussian_shifted = r9,\\n    half_normal = r10\\n  ))\\n}\\n\\n\\n# ============================================================================\\n# SAVE SAMPLE FILES\\n# ============================================================================\\n\\n#\' Save test samples to disk.\\nsave_samples <- function() {\\n  results <- test()\\n\\n  # Save normal samples\\n  writeLines(as.character(results$normal_samples), \\"/app/normal_samples.txt\\")\\n  cat(\\"Saved /app/normal_samples.txt\\\\n\\")\\n\\n  # Also save exponential samples\\n  writeLines(as.character(results$exponential_samples), \\"/app/exponential_samples.txt\\")\\n  cat(\\"Saved /app/exponential_samples.txt\\\\n\\")\\n}\\n\\n# Run tests and save samples when sourced directly.\\nif (!interactive()) {\\n  save_samples()\\n}\\n"'}}]
