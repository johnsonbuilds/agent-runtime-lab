[agent-runtime] llm.chunk iteration=42 content='' reasoning='' tool_calls=[{'index': 0, 'id': None, 'function': {'name': None, 'arguments': '"content": "# Adaptive Rejection Sampling (ARS)\\n# Implements the adaptive rejection sampling algorithm of Gilks & Wild (1992)\\n# for sampling from log-concave densities.\\n# Reference: Gilks, W. R., & Wild, P. (1992). Adaptive rejection sampling for\\n#            Gibbs sampling. Journal of the Royal Statistical Society: Series C\\n#            (Applied Statistics), 41(2), 337-348.\\n\\n# ============================================================================\\n# INPUT VALIDATION\\n# ============================================================================\\n\\n#\' Validate inputs to the ars function\\n#\' @param logdensity A function that evaluates the log of the (possibly\\n#\'   unnormalized) target density at a vector of points.\\n#\' @param x0 A numeric vector of initial support points.\\n#\' @param lower,upper Finite or infinite bounds for the domain.\\n#\' @param n A positive integer giving the number of samples to generate.\\n#\' @return NULL (invisible) if all inputs are valid; otherwise an error is\\n#\'   thrown with an informative message.\\nvalidate_inputs <- function(logdensity, x0, lower, upper, n) {\\n  if (!is.function(logdensity)) {\\n    stop(\\"Argument \'logdensity\' must be a function.\\")\\n  }\\n  if (!is.numeric(n) || length(n) != 1 || n < 1 || n != as.integer(n)) {\\n    stop(\\"Argument \'n\' must be a positive integer.\\")\\n  }\\n  if (!is.infinite(lower)) {\\n    if (!is.numeric(lower) || length(lower) != 1 || is.na(lower)) {\\n      stop(\\"Argument \'lower\' must be a finite number or -Inf.\\")\\n    }\\n  }\\n  if (!is.infinite(upper)) {\\n    if (!is.numeric(upper) || length(upper) != 1 || is.na(upper)) {\\n      stop(\\"Argument \'upper\' must be a finite number or Inf.\\")\\n    }\\n  }\\n  if (lower >= upper) {\\n    stop(\\"Argument \'lower\' must be strictly less than \'upper\'.\\")\\n  }\\n  if (!is.numeric(x0)) {\\n    stop(\\"Argument \'x0\' must be a numeric vector.\\")\\n  }\\n  if (length(x0) < 3) {\\n    stop(\\"Argument \'x0\' must contain at least three points.\\")\\n  }\\n  if (any(is.na(x0))) {\\n    stop(\\"Argument \'x0\' must not contain NA values.\\")\\n  }\\n  x0 <- sort(x0)\\n  if (any(x0 <= lower) || any(x0 >= upper)) {\\n    stop(\\"All elements of \'x0\' must lie strictly between \'lower\' and \'upper\'.\\")\\n  }\\n  if (!all(diff(x0) > 0)) {\\n    stop(\\"Elements of \'x0\' must be in strictly increasing order.\\")\\n  }\\n  logy <- logdensity(x0)\\n  if (!is.numeric(logy) || length(logy) != length(x0)) {\\n    stop(\\"Evaluation of \'logdensity\' at \'x0\' did not return a numeric vector of the same length.\\")\\n  }\\n  if (any(!is.finite(logy))) {\\n    stop(\\"Some evaluations of \'logdensity\' at \'x0\' were not finite.\\")\\n  }\\n  invisible(NULL)\\n}\\n\\n\\n# ============================================================================\\n# LOG-CONCAVITY CHECKS\\n# ============================================================================\\n\\n#\' Check log-concavity at the current support points and on a grid.\\n#\' @param x A numeric vector of strictly increasing support points.\\n#\' @param logy A numeric vector of log-density values at x.\\n#\' @param logdensity The log-density function.\\n#\' @param lower Lower bound of the domain.\\n#\' @param upper Upper bound of the domain.\\n#\' @param tol A small tolerance (default 1e-8) used to allow minor numerical\\n#\'   violations.\\n#\' @param ngrid Number of grid points for the grid check (default 100).\\n#\' @return TRUE if the density appears log-concave, FALSE otherwise.\\ncheck_log_concavity <- function(x, logy, logdensity, lower = -Inf, upper = Inf,\\n                                 tol = 1e-8, ngrid = 100) {\\n  n <- length(x)\\n  if (n < 3) return(TRUE)\\n\\n  # Check slopes are non-increasing on the support points.\\n  h <- diff(x)\\n  slopes <- diff(logy) / h\\n  if (any((slopes[-1] - slopes[-length(slopes)]) > tol)) {\\n    return(FALSE)\\n  }\\n\\n  # Also check on a fine grid between the extreme support points.\\n  grid_lo <- max(x[1] + (x[n] - x[1]) * 0.05, lower + 1e-10)\\n  grid_hi <- min(x[n] - (x[n] - x[1]) * 0.05, upper - 1e-10)\\n  if (grid_hi - grid_lo < 1e-10) return(TRUE)\\n\\n  grid_range <- seq(grid_lo, grid_hi, length.out = min(ngrid, 200))\\n  grid_range <- grid_range[grid_range > x[1] & grid_range < x[n]]\\n  if (length(grid_range) < 3) return(TRUE)\\n\\n  hgrid <- diff(grid_range)\\n  logg <- logdensity(grid_range)\\n  if (any(!is.finite(logg))) return(TRUE)\\n\\n  second_deriv <- numeric(length(grid_range) - 2)\\n  for (i in seq_along(second_deriv)) {\\n    second_deriv[i] <- (logg[i + 2] - 2 * logg[i + 1] + logg[i]) /\\n                       (hgrid[i] * hgrid[i + 1])\\n  }\\n  if (any(second_deriv > tol)) {\\n    return(FALSE)\\n  }\\n  TRUE\\n}\\n\\n\\n# ============================================================================\\n# NUMERICALLY STABLE UTILITIES\\n# ============================================================================\\n\\n#\' Log-space sum of exponentials (log-sum-exp trick).\\nlogsumexp <- function(x) {\\n  if (length(x) == 0) return(-Inf)\\n  max_x <- max(x, na.rm = TRUE)\\n  if (!is.finite(max_x)) return(-Inf)\\n  max_x + log(sum(exp(x - max_x)))\\n}\\n\\n#\' Log-space difference of exponentials: log(exp(a) - exp(b)) for a > b.\\n#\' Vectorized over a and b.\\nlog_diff_exp <- function(a, b) {\\n  if (length(a) != length(b)) stop(\\"a and b must have the same length\\")\\n  result <- numeric(length(a))\\n  for (i in seq_along(a)) {\\n    ai <- a[i]; bi <- b[i]\\n    if (!is.finite(ai) || !is.finite(bi) || ai <= bi || (ai - bi) < -700) {\\n      result[i] <- -Inf\\n    } else {\\n      result[i] <- bi + log(exp(ai - bi) - 1)\\n    }\\n  }\\n  result\\n}\\n\\n#\' Compute log(area) of segment i of the piecewise linear envelope.\\nsegment_log_area <- function(a, b, h) {\\n  if (abs(b) < 1e-12) {\\n    return(log(h) + a)\\n  }\\n  if (b > 0) {\\n    return(log_diff_exp(a + b * h, a) - log(b))\\n  } else {\\n    return(log_diff_exp(a, a + b * h) - log(-b))\\n  }\\n}\\n\\n#\' Vectorised log-area computation for multiple segments.\\nsegment_log_areas <- function(a, b, h) {\\n  result <- numeric(length(a))\\n  flat_mask <- abs(b) < 1e-12\\n  result[flat_mask] <- log(h[flat_mask]) + a[flat_mask]\\n  pos_mask <- !flat_mask & b > 0\\n  if (any(pos_mask)) {\\n    result[pos_mask] <- log_diff_exp(a[pos_mask] + b[pos_mask] * h[pos_mask],\\n                                     a[pos_mask]) - log(b[pos_mask])\\n  }\\n  neg_mask <- !flat_mask & b <= 0\\n  if (any(neg_mask)) {\\n    result[neg_mask] <- log_diff_exp(a[neg_mask],\\n                                     a[neg_mask] + b[neg_mask] * h[neg_mask]) -\\n                         log(-b[neg_mask])\\n  }\\n  result\\n}\\n\\n\\n# ============================================================================\\n# UPPER ENVELOPE CONSTRUCTION\\n# ============================================================================\\n\\n#\' Compute the coefficients of the piecewise linear upper envelope in log space.\\n#\' @param x Support points (increasing).\\n#\' @param logy Log-density values at x.\\n#\' @return A list with components a, b (intercept and slope on each segment)\\n#\'   and logZ (log of the integral of the envelope).\\ncompute_envelope <- function(x, logy) {\\n  n <- length(x)\\n  h <- diff(x)\\n  slopes <- diff(logy) / h\\n  a <- logy[-n] - slopes * x[-n]\\n  b <- slopes\\n  log_areas <- segment_log_areas(a, b, h)\\n  logZ <- logsumexp(log_areas)\\n  list(a = a, b = b, logZ = logZ)\\n}\\n\\n\\n# ============================================================================\\n# SAMPLING FROM THE ENVELOPE\\n# ============================================================================\\n\\n#\' Sample from the piecewise linear upper envelope.\\n#\' @param envelope The envelope list.\\n#\' @param x Support points.\\n#\' @param n_sample Number of samples to draw.\\n#\' @return A numeric vector of samples.\\nsample_from_envelope <- function(envelope, x, n_sample) {\\n  n <- length(x)\\n  h <- diff(x)\\n  a <- envelope$a\\n  b <- envelope$b\\n  logZ <- envelope$logZ\\n\\n  log_areas <- segment_log_areas(a, b, h)\\n  probs <- exp(log_areas - logZ)\\n  probs[is.na(probs) | probs <= 0] <- .Machine$double.eps\\n  probs <- probs / sum(probs)\\n\\n  seg_idx <- sample(seq_len(n - 1), size = n_sample, replace = TRUE, prob = probs)\\n\\n  samples <- numeric(n_sample)\\n  u <- runif(n_sample)\\n  for (k in seq_len(n_sample)) {\\n    i <- seg_idx[k]\\n    ui <- u[k]\\n    bi <- b[i]\\n    if (abs(bi) < 1e-12) {\\n      samples[k] <- x[i] + ui * h[i]\\n    } else {\\n      samples[k] <- x[i] + log(1 + ui * (exp(bi * h[i]) - 1)) / bi\\n    }\\n  }\\n  samples\\n}\\n\\n\\n# ============================================================================\\n# MAIN ARS FUNCTION\\n# ============================================================================\\n\\n#\' Adaptive Rejection Sampling\\n#\'\\n#\' Generate \\\\code{n} samples from a log-concave density proportional to\\n#\' \\\\code{exp(logdensity(x))} on the interval (\\\\code{lower}, \\\\code{upper}).\\n#\'\\n#\' @param logdensity A function evaluating the log of the (possibly\\n#\'   unnormalized) target density. Must accept a vector of points and return\\n#\'   a vector of the same length.\\n#\' @param x0 A numeric vector of at least three starting support points\\n#\'   strictly inside (\\\\code{lower}, \\\\code{upper}).\\n#\' @param lower Lower bound of the support (\\\\code{-Inf} allowed).\\n#\' @param upper Upper bound of the support (\\\\code{Inf} allowed).\\n#\' @param n Number of samples to generate.\\n#\' @param max_support Maximum number of support points (default 100).\\n#\'   Once reached, no new points are added.\\n#\' @return A numeric vector of \\\\code{n} samples from the target distribution.\\nars <- function(logdensity, x0, lower = -Inf, upper = Inf, n, max_support = 100) {\\n  validate_inputs(logdensity, x0, lower, upper, n)\\n\\n  x <- sort(x0)\\n  logy <- logdensity(x)\\n  n_support <- length(x)\\n\\n  envelope <- compute_envelope(x, logy)\\n\\n  samples <- numeric(n)\\n  n_generated <- 0\\n  n_rejected <- 0\\n  max_iter <- max(n * 200, 20000)\\n\\n  while (n_generated < n && n_rejected < max_iter) {\\n    cand <- sample_from_envelope(envelope, x, 1)\\n\\n    log_target <- logdensity(cand)\\n    if (!is.finite(log_target)) {\\n      n_rejected <- n_rejected + 1\\n      next\\n    }\\n\\n    seg <- findInterval(cand, x, rightmost.closed = FALSE)\\n    if (seg >= n_support) seg <- n_support - 1\\n    if (seg < 1) seg <- 1\\n    log_env <- envelope$a[seg] + envelope$b[seg] * (cand - x[seg])\\n\\n    u <- runif(1)\\n    if (log(u) <= log_target - log_env) {\\n      n_generated <- n_generated + 1\\n      samples[n_generated] <- cand\\n    } else {\\n      n_rejected <- n_rejected + 1\\n      if (n_support < max_support) {\\n        x <- c(x, cand)\\n        logy <- c(logy, logdensity(cand))\\n        idx <- order(x)\\n        x <- x[idx]\\n        logy <- logy[idx]\\n        n_support <- length(x)\\n        if (!check_log_concavity(x, logy, logdensity, lower, upper)) {\\n          stop(\\"Log-concavity assumption violated during sampling. \\",\\n               \\"The target density may not be log-concave.\\")\\n        }\\n        envelope <- compute_envelope(x, logy)\\n      }\\n    }\\n  }\\n\\n  if (n_generated < n) {\\n    stop(\\"Sampling failed to produce enough samples within the iteration limit.\\")\\n  }\\n\\n  samples\\n}\\n\\n\\n# ============================================================================\\n# TEST SUITE\\n# ============================================================================\\n\\n#\' Formal tests for the adaptive rejection sampler.\\ntest <- function() {\\n  cat(\\"=== Adaptive Rejection Sampling Test Suite ===\\\\n\\\\n\\")\\n\\n  passed <- 0\\n  failed <- 0\\n\\n  run_test <- function(name, condition) {\\n    if (condition) {\\n      cat(sprintf(\\"%s: PASS\\\\n\\", name))\\n      passed <<- passed + 1\\n    } else {\\n      cat(sprintf(\\"%s: FAIL\\\\n\\", name))\\n      failed <<- failed + 1\\n    }\\n  }\\n\\n  # --------------------------------------------------------------------------\\n  # Test 1: INPUT VALIDATION — negative n\\n  # --------------------------------------------------------------------------\\n  ok <- FALSE\\n  tryCatch({\\n    ars(function(x) -x^2 / 2, x0 = c(-1, 0, 1), lower = -Inf, upper = Inf, n = -1)\\n  }, error = function(e) {\\n    if (grepl(\\"positive integer\\", e$message, ignore.case = TRUE)) ok <<- TRUE\\n  })\\n  run_test(\\"INPUT_NEGATIVE_N\\", ok)\\n\\n  # --------------------------------------------------------------------------\\n  # Test 2: INPUT VALIDATION — non-function logdensity\\n  # --------------------------------------------------------------------------\\n  ok <- FALSE\\n  tryCatch({\\n    ars(42, x0 = c(-1, 0, 1), lower = -Inf, upper = Inf, n = 10)\\n  }, error = function(e) {\\n    if (grepl(\\"must be a function\\", e$message, ignore.case = TRUE)) ok <<- TRUE\\n  })\\n  run_test(\\"INPUT_NONFUNCTION_LOGDENSITY\\", ok)\\n\\n  # --------------------------------------------------------------------------\\n  # Test 3: INPUT VALIDATION — too few support points\\n  # --------------------------------------------------------------------------\\n  ok <- FALSE\\n  tryCatch({\\n    ars(function(x) -x^2 / 2, x0 = c(0, 1), lower = -Inf, upper = Inf, n = 10)\\n  }, error = function(e) {\\n    if (grepl(\\"at least three\\", e$message, ignore.case = TRUE)) ok <<- TRUE\\n  })\\n  run_test(\\"INPUT_FEW_SUPPORT_POINTS\\", ok)\\n\\n  # --------------------------------------------------------------------------\\n  # Test 4: INPUT VALIDATION — x0 outside bounds\\n  # --------------------------------------------------------------------------\\n  ok <- FALSE\\n  tryCatch({\\n    ars(function(x) -x^2 / 2, x0 = c(-1, 0, 5), lower = -Inf, upper = 3, n = 10)\\n  }, error = function(e) {\\n    if (grepl(\\"strictly between\\", e$message, ignore.case = TRUE)) ok <<- TRUE\\n  })\\n  run_test(\\"INPUT_X0_OUTSIDE_BOUNDS\\", ok)\\n\\n  # --------------------------------------------------------------------------\\n  # Test 5: STANDARD NORMAL — mean and variance (fast, n=2000)\\n  # --------------------------------------------------------------------------\\n  cat(\\"\\\\n--- Sampling from standard normal ---\\\\n\\")\\n  set.seed(2024)\\n  normal_samples <- ars(function(x) -x^2 / 2,\\n                        x0 = c(-3, 0, 3),\\n                        lower = -Inf, upper = Inf,\\n                        n = 2000)\\n  m <- mean(normal_samples)\\n  s <- sd(normal_samples)\\n  pass <- abs(m - 0) < 0.1 & abs(s - 1) < 0.1\\n  run_test(\\"NORMAL_MEAN_VARIANCE\\", pass)\\n  cat(sprintf(\\"  mean=%.4f, sd=%.4f\\\\n\\", m, s))\\n\\n  # --------------------------------------------------------------------------\\n  # Test 6: EXPONENTIAL — mean and variance (fast, n=2000)\\n  # --------------------------------------------------------------------------\\n  cat(\\"\\\\n--- Sampling from exponential(1) ---\\\\n\\")\\n  set.seed(2024)\\n  exp_samples <- ars(function(x) -x,\\n                     x0 = c(0.1, 1, 5),\\n                     lower = 0, upper = Inf,\\n                     n = 2000)\\n  m <- mean(exp_samples)\\n  s <- sd(exp_samples)\\n  pass <- abs(m - 1) < 0.1 & abs(s - 1) < 0.1\\n  run_test(\\"EXPONENTIAL_MEAN_VARIANCE\\", pass)\\n  cat(sprintf(\\"  mean=%.4f, sd=%.4f\\\\n\\", m, s))\\n\\n  # --------------------------------------------------------------------------\\n  # Test 7: NON LOG-CONCAVE DENSITY — should error\\n  # --------------------------------------------------------------------------\\n  cat(\\"\\\\n--- Testing non-log-concave density rejection ---\\\\n\\")\\n  ok <- FALSE\\n  bad_density <- function(x) {\\n    log(0.5 * dnorm(x, -3) + 0.5 * dnorm(x, 3))\\n  }\\n  tryCatch({\\n    ars(bad_density, x0 = c(-6, -3, 0, 3, 6), lower = -Inf, upper = Inf, n = 10)\\n  }, error = function(e) {\\n    if (grepl(\\"log-concavity\\", e$message, ignore.case = TRUE)) ok <<- TRUE\\n  })\\n  run_test(\\"NON_LOGCONCAVE_REJECTED\\", ok)\\n\\n  # --------------------------------------------------------------------------\\n  # Test 8: KS TEST vs KNOWN DISTRIBUTION (Normal)\\n  # --------------------------------------------------------------------------\\n  cat(\\"\\\\n--- KS test against standard normal ---\\\\n\\")\\n  set.seed(2024)\\n  normal_ks_samples <- ars(function(x) -x^2 / 2,\\n                           x0 = c(-3, 0, 3),\\n                           lower = -Inf, upper = Inf,\\n                           n = 2000)\\n  pval <- ks.test(normal_ks_samples, \\"pnorm\\", mean = 0, sd = 1)$p.value\\n  pass <- pval > 0.01\\n  run_test(\\"KS_NORMAL\\", pass)\\n  cat(sprintf(\\"  KS p-value=%.4f\\\\n\\", pval))\\n\\n  # --------------------------------------------------------------------------\\n  # Test 9: KS TEST vs KNOWN DISTRIBUTION (Exponential)\\n  # --------------------------------------------------------------------------\\n  cat(\\"\\\\n--- KS test against exponential(1) ---\\\\n\\")\\n  set.seed(2024)\\n  exp_ks_samples <- ars(function(x) -x,\\n                        x0 = c(0.1, 1, 5),\\n                        lower = 0, upper = Inf,\\n                        n = 2000)\\n  pval <- ks.test(exp_ks_samples, \\"pexp\\", rate = 1)$p.value\\n  pass <- pval > 0.01\\n  run_test(\\"KS_EXPONENTIAL\\", pass)\\n  cat(sprintf(\\"  KS p-value=%.4f\\\\n\\", pval))\\n\\n  # --------------------------------------------------------------------------\\n  # Test 10: GAUSSIAN WITH NON-STANDARD PARAMETERS\\n  # --------------------------------------------------------------------------\\n  cat(\\"\\\\n--- Sampling from N(5, 4) ---\\\\n\\")\\n  set.seed(2024)\\n  gaussian_shifted <- ars(function(x) -((x - 5)^2) / 8,\\n                          x0 = c(3, 5, 7),\\n                          lower = -Inf, upper = Inf,\\n                          n = 2000)\\n  m <- mean(gaussian_shifted)\\n  s <- sd(gaussian_shifted)\\n  pass <- abs(m - 5) < 0.1 & abs(s - 2) < 0.1\\n  run_test(\\"GAUSSIAN_SHIFTED\\", pass)\\n  cat(sprintf(\\"  mean=%.4f, sd=%.4f\\\\n\\", m, s))\\n\\n  # --------------------------------------------------------------------------\\n  # Test 11: HALF-NORMAL (truncated normal)\\n  # --------------------------------------------------------------------------\\n  cat(\\"\\\\n--- Sampling from half-normal ---\\\\n\\")\\n  set.seed(2024)\\n  half_normal <- ars(function(x) -x^2 / 2,\\n                     x0 = c(0.1, 1, 3),\\n                     lower = 0, upper = Inf,\\n                     n = 2000)\\n  m <- mean(half_normal)\\n  expected_mean <- sqrt(2 / pi)\\n  pass <- abs(m - expected_mean) < 0.1\\n  run_test(\\"HALF_NORMAL\\", pass)\\n  cat(sprintf(\\"  mean=%.4f, expected=%.4f\\\\n\\", m, expected_mean))\\n\\n  # --------------------------------------------------------------------------\\n  # Test 12: SAMPLE FILE GENERATION — normal\\n  # --------------------------------------------------------------------------\\n  cat(\\"\\\\n--- Generating sample files ---\\\\n\\")\\n  set.seed(2024)\\n  normal_file_samples <- ars(function(x) -x^2 / 2,\\n                              x0 = c(-3, 0, 3),\\n                              lower = -Inf, upper = Inf,\\n                              n = 1000)\\n  writeLines(format(normal_file_samples), \\"/app/normal_samples.txt\\")\\n  run_test(\\"SAMPLE_FILE_NORMAL\\", file.exists(\\"/app/normal_samples.txt\\"))\\n  cat(\\"  Saved /app/normal_samples.txt\\\\n\\")\\n\\n  # --------------------------------------------------------------------------\\n  # Test 13: SAMPLE FILE GENERATION — exponential\\n  # --------------------------------------------------------------------------\\n  set.seed(2024)\\n  exp_file_samples <- ars(function(x) -x,\\n                          x0 = c(0.1, 1, 5),\\n                          lower = 0, upper = Inf,\\n                          n = 1000)\\n  writeLines(format(exp_file_samples), \\"/app/exponential_samples.txt\\")\\n  run_test(\\"SAMPLE_FILE_EXPONENTIAL\\", file.exists(\\"/app/exponential_samples.txt\\"))\\n  cat(\\"  Saved /app/exponential_samples.txt\\\\n\\")\\n\\n  # --- Summary ---------------------------------------------------------------\\n  cat(\\"\\\\n=== Summary ===\\\\n\\")\\n  cat(sprintf(\\"Passed: %d / %d\\\\n\\", passed, passed + failed))\\n  cat(sprintf(\\"Failed: %d / %d\\\\n\\", failed, passed + failed))\\n\\n  invisible(list(\\n    normal_samples = normal_file_samples,\\n    exponential_samples = exp_file_samples,\\n    normal_ks = normal_ks_samples,\\n    exponential_ks = exp_ks_samples,\\n    gaussian_shifted = gaussian_shifted,\\n    half_normal = half_normal\\n  ))\\n}\\n\\n\\n# ============================================================================\\n# RUN TESTS\\n# ============================================================================\\n\\nif (!interactive()) {\\n  test()\\n}\\n"'}}]
