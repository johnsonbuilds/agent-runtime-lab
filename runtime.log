[agent-runtime] llm.chunk iteration=5 content='' reasoning='' tool_calls=[{'index': 1, 'id': None, 'function': {'name': None, 'arguments': '"content": "#\' Adaptive Rejection Sampling (ARS)\\n#\'\\n#\' Implements the adaptive rejection sampler of Gilks & Wild (1992) for\\n#\' generating random variates from a log-concave density.\\n#\'\\n#\' @param n Number of samples to generate.\\n#\' @param logdens Function returning the log of the (possibly unnormalized)\\n#\'   density, evaluated vectorized over x. Must be log-concave.\\n#\' @param xlow Lower bound of the domain (finite or -Inf).\\n#\' @param xup Upper bound of the domain (finite or Inf).\\n#\' @param x0 Initial abscissae at which to evaluate the log-density.\\n#\'   Must contain at least 3 points strictly inside (xlow, xup).\\n#\' @param verbose Logical; if TRUE, print progress messages.\\n#\' @return A numeric vector of samples from the target distribution.\\n#\' @references Gilks, W. R., & Wild, P. (1992). Adaptive rejection sampling\\n#\'   for Gibbs sampling. Journal of the Royal Statistical Society: Series C,\\n#\'   41(2), 337-348.\\nars <- function(n, logdens, xlow, xup, x0, verbose = FALSE) {\\n  ## ---- input validation ----------------------------------------------------\\n  check <- .validate_inputs(n, logdens, xlow, xup, x0)\\n  if (!isTRUE(check$valid)) {\\n    stop(check$message)\\n  }\\n\\n  n       <- check$n\\n  logdens <- check$logdens\\n  xlow    <- check$xlow\\n  xup     <- check$xup\\n  x0      <- sort(check$x0)\\n\\n  ## ---- initialize nodes and log-densities ----------------------------------\\n  x      <- x0\\n  logf   <- logdens(x)\\n  logfp  <- rep(NA_real_, length(x))  # derivatives at nodes\\n  for (i in seq_along(x)) {\\n    logfp[i] <- .num_derivative(logdens, x[i])\\n  }\\n\\n  samples <- integer(0)\\n\\n  ## ---- main sampling loop --------------------------------------------------\\n  while (length(samples) < n) {\\n    ## Build the lower envelope (piecewise linear in log-space, i.e.\\n    ## piecewise exponential in density space).\\n    env <- .build_lower_envelope(x, logf, logfp, xlow, xup)\\n\\n    ## Sample a candidate from the lower envelope.\\n    u      <- runif(1)\\n    xx     <- .sample_from_envelope(u, env, xlow, xup)\\n    logfxx <- logdens(xx)\\n\\n    ## Log-concavity check: the candidate must lie below the lower envelope.\\n    if (logfxx > env$y[env$idx] + env$m[env$idx] * (xx - env$xl[env$idx])) {\\n      stop(\\n        \\"Log-concavity violated at x = \\", round(xx, 6),\\n        \\". The supplied log-density does not appear to be log-concave.\\"\\n      )\\n    }\\n\\n    ## Acceptance test: U <= exp(logf(xx) - envelope(xx)).\\n    u2 <- runif(1)\\n    accept_log <- logfxx - (env$y[env$idx] + env$m[env$idx] * (xx - env$xl[env$idx]))\\n    if (u2 <= exp(accept_log)) {\\n      samples <- c(samples, xx)\\n      if (verbose) {\\n        cat(\\"Accepted sample:\\", round(xx, 6), \\"\\\\n\\")\\n      }\\n    }\\n\\n    ## Even if rejected, add the point to the node set so the envelope\\n    ## improves (per Gilks & Wild 1992, Section 3).\\n    if (xx > xlow && xx < xup) {\\n      .add_node(x, logf, logfp, logdens, xx)\\n      env <- .build_lower_envelope(x, logf, logfp, xlow, xup)\\n    }\\n  }\\n\\n  return(samples[1:n])\\n}\\n\\n## ---- helper: validate inputs -----------------------------------------------\\n.validate_inputs <- function(n, logdens, xlow, xup, x0) {\\n  out <- list(valid = TRUE, n = n, logdens = logdens,\\n              xlow = xlow, xup = xup, x0 = x0)\\n\\n  ## n must be a positive integer\\n  if (length(n) != 1 || !is.numeric(n) || n != as.integer(n) || n <= 0) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'n\' must be a positive integer.\\"\\n    return(out)\\n  }\\n  out$n <- as.integer(n)\\n\\n  ## logdens must be a function\\n  if (!is.function(logdens)) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'logdens\' must be a function.\\"\\n    return(out)\\n  }\\n\\n  ## Domain bounds\\n  if (!is.numeric(xlow) || length(xlow) != 1 || is.nan(xlow) || is.infinite(xlow)) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'xlow\' must be a finite numeric value.\\"\\n    return(out)\\n  }\\n  if (!is.numeric(xup) || length(xup) != 1 || is.nan(xup) || is.infinite(xup)) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'xup\' must be a finite numeric value.\\"\\n    return(out)\\n  }\\n  if (xlow >= xup) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'xlow\' must be strictly less than \'xup\'.\\"\\n    return(out)\\n  }\\n  out$xlow <- xlow\\n  out$xup  <- xup\\n\\n  ## Initial abscissae\\n  if (!is.numeric(x0) || length(x0) < 3) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'x0\' must be a numeric vector of at least 3 points.\\"\\n    return(out)\\n  }\\n  x0_sorted <- sort(x0)\\n  if (any(x0_sorted <= xlow) || any(x0_sorted >= xup)) {\\n    out$valid <- FALSE\\n    out$message <- \\"All initial abscissae must lie strictly inside (xlow, xup).\\"\\n    return(out)\\n  }\\n  out$x0 <- x0_sorted\\n\\n  ## Quick sanity check: log-density should evaluate without error.\\n  tryCatch({\\n    vals <- logdens(x0)\\n    if (!is.numeric(vals) || length(vals) != length(x0)) {\\n      stop(\\"logdens did not return a numeric vector of the same length.\\")\\n    }\\n    if (any(is.nan(vals) | is.infinite(vals))) {\\n      out$valid <- FALSE\\n      out$message <- \\"log-density returned NaN or Inf at some initial points.\\"\\n      return(out)\\n    }\\n  }, error = function(e) {\\n    out$valid <- FALSE\\n    out$message <- paste(\\"Error evaluating log-density:\\", e$message)\\n  })\\n\\n  return(out)\\n}\\n\\n## ---- helper: numerical derivative ------------------------------------------\\n.num_derivative <- function(f, x, h = 1e-7) {\\n  (f(x + h) - f(x - h)) / (2 * h)\\n}\\n\\n## ---- helper: add a node and update log-derivatives -------------------------\\n.add_node <- function(x, logf, logfp, logdens, xx) {\\n  idx <- .find_insert_pos(x, xx)\\n  x      <- c(x[1:(idx - 1)], xx, x[idx:length(x)])\\n  logf   <- c(logf[1:(idx - 1)], logdens(xx), logf[idx:length(logf)])\\n  logfp  <- c(logfp[1:(idx - 1)], .num_derivative(logdens, xx), logfp[idx:length(logfp)])\\n  assign(\\"x\\",      x,      envir = .GlobalEnv)\\n  assign(\\"logf\\",   logf,   envir = .GlobalEnv)\\n  assign(\\"logfp\\",  logfp,  envir = .GlobalEnv)\\n  NULL\\n}\\n\\n## ---- helper: find insert position ------------------------------------------\\n.find_insert_pos <- function(x, xx) {\\n  for (i in seq_along(x)) {\\n    if (xx < x[i]) return(i)\\n  }\\n  length(x) + 1\\n}\\n\\n## ---- helper: build the lower envelope (tangents + secants) -----------------\\n.build_lower_envelope <- function(x, logf, logfp, xlow, xup) {\\n  k <- length(x)\\n  m <- numeric(k)   # slope of the lower-bound line on each sub-interval\\n  y <- numeric(k)   # intercept (value at x) on the lower-bound line\\n  xl <- numeric(k)  # left endpoint of each sub-interval\\n  xr <- numeric(k)  # right endpoint of each sub-interval\\n  w  <- numeric(k)  # weight (unnormalized area contribution)\\n\\n  for (i in 1:k) {\\n    if (i == 1) {\\n      ## Leftmost interval: use the tangent at x[1], truncated by x[2].\\n      m[i] <- logfp[i]\\n      y[i] <- logf[i] - m[i] * x[i]\\n      xl[i] <- xlow\\n      xr[i] <- x[i + 1]\\n    } else if (i == k) {\\n      ## Rightmost interval: use the tangent at x[k], truncated by x[k-1].\\n      m[i] <- logfp[i]\\n      y[i] <- logf[i] - m[i] * x[i]\\n      xl[i] <- x[i - 1]\\n      xr[i] <- xup\\n    } else {\\n      ## Middle interval: upper envelope is min(tangent at i, secant with i-1, secant with i+1).\\n      ## The lower envelope is the tangent line at x[i].\\n      m[i] <- logfp[i]\\n      y[i] <- logf[i] - m[i] * x[i]\\n      xl[i] <- x[i - 1]\\n      xr[i] <- x[i + 1]\\n    }\\n\\n    ## Compute the (log) integral of exp(line) over [xl, xr].\\n    a <- m[i]\\n    b <- y[i]\\n    left  <- xl[i]\\n    right <- xr[i]\\n    if (abs(a) < 1e-12) {\\n      integrand <- (right - left) * exp(b)\\n    } else {\\n      integrand <- (exp(a * right + b) - exp(a * left + b)) / a\\n    }\\n    w[i] <- integrand\\n  }\\n\\n  return(list(m = m, y = y, xl = xl, xr = xr, w = w, x = x, logf = logf, logfp = logfp))\\n}\\n\\n## ---- helper: sample from the lower envelope --------------------------------\\n.sample_from_envelope <- function(u, env, xlow, xup) {\\n  w  <- env$w\\n  xl <- env$xl\\n  xr <- env$xr\\n  m  <- env$m\\n  y  <- env$y\\n\\n  cumw <- cumsum(w)\\n  total <- cumw[length(cumw)]\\n  u_scaled <- u * total\\n\\n  idx <- which.max(cumw >= u_scaled)\\n\\n  ## Invert the CDF of the truncated exponential on [xl[idx], xr[idx]].\\n  a <- m[idx]\\n  b <- y[idx]\\n  left  <- xl[idx]\\n  right <- xr[idx]\\n\\n  if (abs(a) < 1e-12) {\\n    ## Constant density on this interval.\\n    xx <- left + u * (right - left)\\n  } else {\\n    cdf_left  <- exp(a * left + b)\\n    cdf_right <- exp(a * right + b)\\n    portion   <- u * (cdf_right - cdf_left) + cdf_left\\n    xx <- (log(portion) - b) / a\\n  }\\n\\n  return(xx)\\n}\\n\\n## ---- helper: evaluate lower envelope at a point ----------------------------\\n.envelope_value <- function(xx, env) {\\n  x <- env$x\\n  idx <- max(which(x <= xx))\\n  if (idx == 0) idx <- 1\\n  if (idx > length(x)) idx <- length(x)\\n  env$y[idx] + env$m[idx] * (xx - env$x[idx])\\n}\\n"'}}]
