[agent-runtime] llm.chunk iteration=12 content='' reasoning='' tool_calls=[{'index': 0, 'id': None, 'function': {'name': None, 'arguments': '"content": "#\' Adaptive Rejection Sampling (ARS)\\n#\'\\n#\' Implements the adaptive rejection sampler of Gilks & Wild (1992) for\\n#\' generating random variates from a log-concave density.\\n#\'\\n#\' @param n Number of samples to generate.\\n#\' @param logdens Function returning the log of the (possibly unnormalized)\\n#\'   density, evaluated vectorized over x. Must be log-concave.\\n#\' @param xlow Lower bound of the domain (finite or -Inf).\\n#\' @param xup Upper bound of the domain (finite or Inf).\\n#\' @param x0 Initial abscissae at which to evaluate the log-density.\\n#\'   Must contain at least 3 points strictly inside (xlow, xup).\\n#\' @param verbose Logical; if TRUE, print progress messages.\\n#\' @return A numeric vector of samples from the target distribution.\\n#\' @references Gilks, W. R., & Wild, P. (1992). Adaptive rejection sampling\\n#\'   for Gibbs sampling. Journal of the Royal Statistical Society: Series C,\\n#\'   41(2), 337-348.\\nars <- function(n, logdens, xlow, xup, x0, verbose = FALSE) {\\n  ## ---- input validation ----------------------------------------------------\\n  check <- .validate_inputs(n, logdens, xlow, xup, x0)\\n  if (!isTRUE(check$valid)) {\\n    stop(check$message)\\n  }\\n\\n  n       <- check$n\\n  logdens <- check$logdens\\n  xlow    <- check$xlow\\n  xup     <- check$xup\\n  x0      <- sort(check$x0)\\n\\n  ## ---- mutable state via environment ---------------------------------------\\n  state <- new.env(parent = emptyenv())\\n  state$x      <- x0\\n  state$logf   <- logdens(x0)\\n  state$logfp  <- sapply(x0, function(xi) .num_derivative(logdens, xi))\\n\\n  samples <- integer(0)\\n\\n  ## ---- main sampling loop --------------------------------------------------\\n  while (length(samples) < n) {\\n    env <- .build_lower_envelope(state$x, state$logf, state$logfp, xlow, xup)\\n\\n    ## Sample a candidate from the lower envelope.\\n    u      <- runif(1)\\n    xx     <- .sample_from_envelope(u, env)\\n    logfxx <- logdens(xx)\\n\\n    ## Log-concavity check: the candidate must lie below the lower envelope.\\n    env_val <- .envelope_value(xx, env)\\n    if (logfxx > env_val) {\\n      stop(\\n        \\"Log-concavity violated at x = \\", round(xx, 6),\\n        \\". The supplied log-density does not appear to be log-concave.\\"\\n      )\\n    }\\n\\n    ## Acceptance test: U <= exp(logf(xx) - envelope(xx)).\\n    u2 <- runif(1)\\n    accept_log <- logfxx - env_val\\n    if (u2 <= exp(accept_log)) {\\n      samples <- c(samples, xx)\\n      if (verbose) {\\n        cat(\\"Accepted sample:\\", round(xx, 6), \\"\\\\n\\")\\n      }\\n    }\\n\\n    ## Even if rejected, add the point to the node set so the envelope improves.\\n    if (!is.infinite(xx) && xx > xlow && xx < xup) {\\n      .add_node(state, logdens, xx)\\n    }\\n  }\\n\\n  return(samples[1:n])\\n}\\n\\n## ---- helper: validate inputs -----------------------------------------------\\n.validate_inputs <- function(n, logdens, xlow, xup, x0) {\\n  out <- list(valid = TRUE, n = n, logdens = logdens,\\n              xlow = xlow, xup = xup, x0 = x0)\\n\\n  if (length(n) != 1 || !is.numeric(n) || n != as.integer(n) || n <= 0) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'n\' must be a positive integer.\\"\\n    return(out)\\n  }\\n  out$n <- as.integer(n)\\n\\n  if (!is.function(logdens)) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'logdens\' must be a function.\\"\\n    return(out)\\n  }\\n\\n  if (!is.numeric(xlow) || length(xlow) != 1 || is.nan(xlow)) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'xlow\' must be a numeric value (may be -Inf).\\"\\n    return(out)\\n  }\\n  if (!is.numeric(xup) || length(xup) != 1 || is.nan(xup)) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'xup\' must be a numeric value (may be Inf).\\"\\n    return(out)\\n  }\\n  if (!is.infinite(xlow) && !is.infinite(xup) && xlow >= xup) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'xlow\' must be strictly less than \'xup\'.\\"\\n    return(out)\\n  }\\n  out$xlow <- xlow\\n  out$xup  <- xup\\n\\n  if (!is.numeric(x0) || length(x0) < 3) {\\n    out$valid <- FALSE\\n    out$message <- \\"\'x0\' must be a numeric vector of at least 3 points.\\"\\n    return(out)\\n  }\\n  x0_sorted <- sort(x0)\\n  if (any(is.infinite(xlow) & x0_sorted <= 0) && !is.infinite(xlow)) {\\n    out$valid <- FALSE\\n    out$message <- \\"All initial abscissae must lie strictly inside (xlow, xup).\\"\\n    return(out)\\n  }\\n  if (any(is.infinite(xup) & x0_sorted >= 0) && !is.infinite(xup)) {\\n    out$valid <- FALSE\\n    out$message <- \\"All initial abscissae must lie strictly inside (xlow, xup).\\"\\n    return(out)\\n  }\\n  if (!is.infinite(xlow) && any(x0_sorted <= xlow)) {\\n    out$valid <- FALSE\\n    out$message <- \\"All initial abscissae must lie strictly inside (xlow, xup).\\"\\n    return(out)\\n  }\\n  if (!is.infinite(xup) && any(x0_sorted >= xup)) {\\n    out$valid <- FALSE\\n    out$message <- \\"All initial abscissae must lie strictly inside (xlow, xup).\\"\\n    return(out)\\n  }\\n  out$x0 <- x0_sorted\\n\\n  tryCatch({\\n    vals <- logdens(x0)\\n    if (!is.numeric(vals) || length(vals) != length(x0)) {\\n      stop(\\"logdens did not return a numeric vector of the same length.\\")\\n    }\\n    if (any(is.nan(vals) | is.infinite(vals))) {\\n      out$valid <- FALSE\\n      out$message <- \\"log-density returned NaN or Inf at some initial points.\\"\\n      return(out)\\n    }\\n  }, error = function(e) {\\n    out$valid <- FALSE\\n    out$message <- paste(\\"Error evaluating log-density:\\", e$message)\\n  })\\n\\n  return(out)\\n}\\n\\n## ---- helper: numerical derivative (central difference) ---------------------\\n.num_derivative <- function(f, x, h = 1e-7) {\\n  (f(x + h) - f(x - h)) / (2 * h)\\n}\\n\\n## ---- helper: find insert position in sorted vector -------------------------\\n.find_insert_pos <- function(x, xx) {\\n  for (i in seq_along(x)) {\\n    if (xx < x[i]) return(i)\\n  }\\n  length(x) + 1\\n}\\n\\n## ---- helper: add a node to mutable state -----------------------------------\\n.add_node <- function(state, logdens, xx) {\\n  idx <- .find_insert_pos(state$x, xx)\\n  x_vec      <- state$x\\n  logf_vec   <- state$logf\\n  logfp_vec  <- state$logfp\\n\\n  x_vec      <- c(x_vec[1:(idx - 1)], xx, x_vec[idx:length(x_vec)])\\n  logf_vec   <- c(logf_vec[1:(idx - 1)], logdens(xx), logf_vec[idx:length(logf_vec)])\\n  logfp_vec  <- c(logfp_vec[1:(idx - 1)], .num_derivative(logdens, xx), logfp_vec[idx:length(logfp_vec)])\\n\\n  state$x      <- x_vec\\n  state$logf   <- logf_vec\\n  state$logfp  <- logfp_vec\\n}\\n\\n## ---- helper: build the lower envelope (tangent lines) ----------------------\\n.build_lower_envelope <- function(x, logf, logfp, xlow, xup) {\\n  k <- length(x)\\n  m  <- numeric(k)\\n  y  <- numeric(k)\\n  xl <- numeric(k)\\n  xr <- numeric(k)\\n  w  <- numeric(k)\\n\\n  for (i in 1:k) {\\n    m[i]  <- logfp[i]\\n    y[i]  <- logf[i] - m[i] * x[i]\\n    xl[i] <- ifelse(i == 1, ifelse(is.infinite(xlow), -1e10, xlow), x[i - 1])\\n    xr[i] <- ifelse(i == k, ifelse(is.infinite(xup), 1e10, xup), x[i + 1])\\n\\n    a <- m[i]\\n    b <- y[i]\\n    left  <- xl[i]\\n    right <- xr[i]\\n    if (abs(a) < 1e-12) {\\n      w[i] <- (right - left) * exp(b)\\n    } else {\\n      w[i] <- (exp(a * right + b) - exp(a * left + b)) / a\\n    }\\n  }\\n\\n  return(list(m = m, y = y, xl = xl, xr = xr, w = w, x = x))\\n}\\n\\n## ---- helper: sample from the lower envelope -------------------------------\\n.sample_from_envelope <- function(u, env) {\\n  cumw  <- cumsum(env$w)\\n  total <- cumw[length(cumw)]\\n  u_scaled <- u * total\\n\\n  idx <- which.max(cumw >= u_scaled)\\n\\n  a <- env$m[idx]\\n  b <- env$y[idx]\\n  left  <- env$xl[idx]\\n  right <- env$xr[idx]\\n\\n  if (abs(a) < 1e-12) {\\n    xx <- left + u * (right - left)\\n  } else {\\n    cdf_left  <- exp(a * left + b)\\n    cdf_right <- exp(a * right + b)\\n    portion   <- u * (cdf_right - cdf_left) + cdf_left\\n    xx <- (log(portion) - b) / a\\n  }\\n\\n  return(xx)\\n}\\n\\n## ---- helper: evaluate lower envelope at a point ---------------------------\\n.envelope_value <- function(xx, env) {\\n  x <- env$x\\n  idx <- max(which(x <= xx))\\n  if (idx == 0) idx <- 1\\n  if (idx > length(x)) idx <- length(x)\\n  return(env$y[idx] + env$m[idx] * (xx - env$x[idx]))\\n}\\n"'}}]
