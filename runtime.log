[agent-runtime] llm.chunk iteration=40 content='' reasoning='' tool_calls=[{'index': 0, 'id': None, 'function': {'name': None, 'arguments': '"content": "# Quick debug script for ARS - standalone, no auto-test\\nlogsumexp <- function(x) {\\n  if (length(x) == 0) return(-Inf)\\n  max_x <- max(x, na.rm = TRUE)\\n  if (!is.finite(max_x)) return(-Inf)\\n  max_x + log(sum(exp(x - max_x)))\\n}\\n\\nlog_diff_exp <- function(a, b) {\\n  if (length(a) != length(b)) stop(\\"a and b must have the same length\\")\\n  result <- numeric(length(a))\\n  for (i in seq_along(a)) {\\n    ai <- a[i]; bi <- b[i]\\n    if (!is.finite(ai) || !is.finite(bi)) {\\n      result[i] <- -Inf\\n    } else if (ai <= bi) {\\n      result[i] <- -Inf\\n    } else if ((ai - bi) < -700) {\\n      result[i] <- -Inf\\n    } else {\\n      result[i] <- bi + log(exp(ai - bi) - 1)\\n    }\\n  }\\n  result\\n}\\n\\nsegment_log_area <- function(a, b, h) {\\n  if (abs(b) < 1e-12) {\\n    return(log(h) + a)\\n  }\\n  if (b > 0) {\\n    return(log_diff_exp(a + b * h, a) - log(b))\\n  } else {\\n    return(log_diff_exp(a, a + b * h) - log(-b))\\n  }\\n}\\n\\nsegment_log_areas <- function(a, b, h) {\\n  result <- numeric(length(a))\\n  flat_mask <- abs(b) < 1e-12\\n  result[flat_mask] <- log(h[flat_mask]) + a[flat_mask]\\n  pos_mask <- !flat_mask & b > 0\\n  if (any(pos_mask)) {\\n    result[pos_mask] <- log_diff_exp(a[pos_mask] + b[pos_mask] * h[pos_mask], a[pos_mask]) - log(b[pos_mask])\\n  }\\n  neg_mask <- !flat_mask & b <= 0\\n  if (any(neg_mask)) {\\n    result[neg_mask] <- log_diff_exp(a[neg_mask], a[neg_mask] + b[neg_mask] * h[neg_mask]) - log(-b[neg_mask])\\n  }\\n  result\\n}\\n\\ncompute_envelope <- function(x, logy) {\\n  n <- length(x)\\n  h <- diff(x)\\n  slopes <- diff(logy) / h\\n  a <- logy[-n] - slopes * x[-n]\\n  b <- slopes\\n  log_areas <- segment_log_areas(a, b, h)\\n  logZ <- logsumexp(log_areas)\\n  list(a = a, b = b, logZ = logZ)\\n}\\n\\nsample_from_envelope <- function(envelope, x, n_sample) {\\n  n <- length(x)\\n  h <- diff(x)\\n  a <- envelope$a\\n  b <- envelope$b\\n  logZ <- envelope$logZ\\n  log_areas <- segment_log_areas(a, b, h)\\n  probs <- exp(log_areas - logZ)\\n  probs[is.na(probs) | probs <= 0] <- .Machine$double.eps\\n  probs <- probs / sum(probs)\\n  seg_idx <- sample(seq_len(n - 1), size = n_sample, replace = TRUE, prob = probs)\\n  samples <- numeric(n_sample)\\n  u <- runif(n_sample)\\n  for (k in seq_len(n_sample)) {\\n    i <- seg_idx[k]\\n    ui <- u[k]\\n    bi <- b[i]\\n    if (abs(bi) < 1e-12) {\\n      samples[k] <- x[i] + ui * h[i]\\n    } else {\\n      samples[k] <- x[i] + log(1 + ui * (exp(bi * h[i]) - 1)) / bi\\n    }\\n  }\\n  samples\\n}\\n\\nars <- function(logdensity, x0, lower = -Inf, upper = Inf, n, max_support = 100) {\\n  x <- sort(x0)\\n  logy <- logdensity(x)\\n  n_support <- length(x)\\n  envelope <- compute_envelope(x, logy)\\n  samples <- numeric(n)\\n  n_generated <- 0\\n  n_rejected <- 0\\n  max_iter <- max(n * 200, 20000)\\n  \\n  while (n_generated < n && n_rejected < max_iter) {\\n    cand <- sample_from_envelope(envelope, x, 1)\\n    log_target <- logdensity(cand)\\n    if (!is.finite(log_target)) {\\n      n_rejected <- n_rejected + 1\\n      next\\n    }\\n    seg <- findInterval(cand, x, rightmost.closed = FALSE)\\n    if (seg >= n_support) seg <- n_support - 1\\n    if (seg < 1) seg <- 1\\n    log_env <- envelope$a[seg] + envelope$b[seg] * (cand - x[seg])\\n    u <- runif(1)\\n    if (log(u) <= log_target - log_env) {\\n      n_generated <- n_generated + 1\\n      samples[n_generated] <- cand\\n    } else {\\n      n_rejected <- n_rejected + 1\\n      if (n_support < max_support) {\\n        x <- c(x, cand)\\n        logy <- c(logy, logdensity(cand))\\n        idx <- order(x)\\n        x <- x[idx]\\n        logy <- logy[idx]\\n        n_support <- length(x)\\n        envelope <- compute_envelope(x, logy)\\n      }\\n    }\\n  }\\n  samples\\n}\\n\\nset.seed(42)\\nsamples <- ars(function(x) -x^2/2, x0 = c(-2, 0, 2), lower = -Inf, upper = Inf, n = 500)\\ncat(\\"mean:\\", mean(samples), \\"\\\\n\\")\\ncat(\\"sd:\\", sd(samples), \\"\\\\n\\")\\ncat(\\"min:\\", min(samples), \\"\\\\n\\")\\ncat(\\"max:\\", max(samples), \\"\\\\n\\")\\ncat(\\"n samples:\\", length(samples), \\"\\\\n\\")\\n\\nhist(samples, breaks = 30, main = \\"Standard Normal Samples\\", xlab = \\"x\\")\\ncurve(dnorm(x), add = TRUE, col = \\"red\\", lwd = 2)\\n\\nset.seed(42)\\nsamples2 <- ars(function(x) -x^2/2, x0 = c(-2, 0, 2), lower = -Inf, upper = Inf, n = 100)\\ncat(\\"\\\\n100 samples: mean=\\", mean(samples2), \\"sd=\\", sd(samples2), \\"\\\\n\\")\\n\\n# Also test exponential\\nset.seed(42)\\nexp_samples <- ars(function(x) -x, x0 = c(0.1, 1, 5), lower = 0, upper = Inf, n = 500)\\ncat(\\"\\\\nExponential samples: mean=\\", mean(exp_samples), \\"sd=\\", sd(exp_samples), \\"\\\\n\\")\\nhist(exp_samples, breaks = 30, main = \\"Exponential Samples\\", xlab = \\"x\\")\\ncurve(dexp(x, rate = 1), add = TRUE, col = \\"red\\", lwd = 2)\\n"'}}]
