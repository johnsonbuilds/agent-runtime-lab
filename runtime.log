[agent-runtime] llm.chunk iteration=4 content='' reasoning='' tool_calls=[{'index': 0, 'id': None, 'function': {'name': None, 'arguments': '"content": "# ==============================================================================\\n# Adaptive Rejection Sampling (ARS) - Gilks & Wild (1992)\\n# ==============================================================================\\n# Implements adaptive rejection sampling for drawing independent samples from\\n# a univariate log-concave probability density function (possibly unnormalized).\\n#\\n# Reference: Gilks, W. R., & Wild, P. (1992). Adaptive rejection sampling for\\n#   Gibbs sampling. Journal of the Royal Statistical Society: Series C, 41(2),\\n#   337-348.\\n# ==============================================================================\\n\\n\\n# ------------------------------------------------------------------------------\\n# Section 1: Input Validation\\n# ------------------------------------------------------------------------------\\n\\n.validate_inputs <- function(n, logdens, lower = -Inf, upper = Inf,\\n                            xini = NULL, verbose = FALSE) {\\n  # Validate and coerce inputs; return a list of validated parameters.\\n  # Errors are fatal via stop().\\n\\n  # --- n -----------------------------------------------------------------------\\n  if (!is.numeric(n) || length(n) != 1 || is.na(n))\\n    stop(\\"ars: \'n\' must be a single non-missing numeric value.\\")\\n  if (n != floor(n) || n <= 0)\\n    stop(\\"ars: \'n\' must be a positive integer.\\")\\n\\n  # --- logdens -----------------------------------------------------------------\\n  if (!is.function(logdens))\\n    stop(\\"ars: \'logdens\' must be a function.\\")\\n  # Quick call to see if it works with a vector\\n  tryCatch({\\n    test_vals <- c(-1, 0, 1)\\n    out <- logdens(test_vals)\\n    if (!is.numeric(out) || length(out) != 3)\\n      stop(\\"ars: \'logdens\' must return a numeric vector of same length as input.\\")\\n  }, error = function(e) {\\n    stop(paste(\\"ars: \'logdens\' is not a valid function:\\", e$message))\\n  })\\n\\n  # --- domain ------------------------------------------------------------------\\n  if (!is.numeric(lower) || length(lower) != 1 || is.na(lower))\\n    stop(\\"ars: \'lower\' must be a single non-missing numeric value.\\")\\n  if (!is.numeric(upper) || length(upper) != 1 || is.na(upper))\\n    stop(\\"ars: \'upper\' must be a single non-missing numeric value.\\")\\n  if (lower >= upper)\\n    stop(\\"ars: \'lower\' must be strictly less than \'upper\'.\\")\\n\\n  # --- xini --------------------------------------------------------------------\\n  if (is.null(xini)) {\\n    # Default: three points spread across the domain\\n    width <- upper - lower\\n    xini <- c(lower + 0.1 * width,\\n              lower + 0.5 * width,\\n              upper - 0.1 * width)\\n  } else {\\n    if (!is.numeric(xini) || length(xini) < 3)\\n      stop(\\"ars: \'xini\' must be a numeric vector with at least 3 elements.\\")\\n    xini <- sort(xini)\\n    # Check that all init points lie within the domain\\n    if (any(xini <= lower) || any(xini >= upper))\\n      stop(\\"ars: all initial points in \'xini\' must lie strictly inside (lower, upper).\\")\\n  }\\n  xini <- unique(xini)\\n  if (length(xini) < 3)\\n    stop(\\"ars: after removing duplicates, \'xini\' must have at least 3 distinct points.\\")\\n\\n  # --- verbose -----------------------------------------------------------------\\n  verbose <- as.logical(verbose)\\n  if (length(verbose) != 1 || is.na(verbose)) verbose <- FALSE\\n\\n  list(n = as.integer(n), logdens = logdens, lower = lower, upper = upper,\\n       xini = xini, verbose = verbose)\\n}\\n\\n\\n# ------------------------------------------------------------------------------\\n# Section 2: Log-density Evaluation with Numeric Derivative\\n# ------------------------------------------------------------------------------\\n\\n.evaluate_logdens <- function(logdens, x) {\\n  # Evaluate the (possibly unnormalized) log-density at x.\\n  # Returns a numeric vector of same length as x.\\n  out <- logdens(x)\\n  if (!is.numeric(out) || any(is.nan(out)) || any(is.infinite(out))) {\\n    stop(\\"ars: \'logdens\' returned non-finite values.\\")\\n  }\\n  out\\n}\\n\\n.compute_derivatives <- function(logdens, x, eps = 1e-7) {\\n  # Compute the derivative of log f at each point x_i using central\\n  # differences:  f\'(x)/f(x) ≈ (log f(x+h) - log f(x-h)) / (2h).\\n  h <- eps\\n  dlog <- sapply(x, function(xi) {\\n    xm <- xi - h; xp <- xi + h\\n    if (xm <= -Inf || xp >= Inf) return(NA_real_)\\n    (logdens(xp) - logdens(xm)) / (2 * h)\\n  })\\n  dlog\\n}\\n\\n\\n# ------------------------------------------------------------------------------\\n# Section 3: Log-Concavity Check\\n# ------------------------------------------------------------------------------\\n\\n.check_log_concavity <- function(xi, logy, dlogy) {\\n  # Check whether the triplet (xi, log y_i, dlog y_i) is consistent with\\n  # log f being concave.  For a concave function, the secant slope between\\n  # consecutive points must be non-increasing.  Here we check that for every\\n  # adjacent pair (j-1, j, j+1):\\n  #\\n  #   (log y_j - log y_{j-1}) / (x_j - x_{j-1})  >=\\n  #   dlog y_j  >=\\n  #   (log y_{j+1} - log y_j) / (x_{j+1} - x_j)\\n  #\\n  # Actually, the ARS condition is simpler: the piecewise-linear function\\n  # formed by the tangents must form an upper envelope.  The standard check\\n  # (Gilks & Wild, 1992) is that the slope sequence is non-increasing:\\n  #   slope_j = (logy_{j+1} - logy_j) / (x_{j+1} - x_j)\\n  # and we need slope_1 >= slope_2 >= ... >= slope_{m-1}.\\n  # Also each derivative must lie between the adjacent secant slopes.\\n  m <- length(xi)\\n  if (m < 3) return(TRUE)\\n\\n  secants <- (logy[-1] - logy[-m]) / (xi[-1] - xi[-(m-1)])\\n  # Check monotone decreasing secant slopes\\n  if (!all(diff(secants) <= 1e-10)) {\\n    return(FALSE)\\n  }\\n  # Check each derivative lies between adjacent secants\\n  for (j in 2:(m-1)) {\\n    if (dlogy[j] > secants[j-1] + 1e-10 || dlogy[j] < secants[j] - 1e-10) {\\n      return(FALSE)\\n    }\\n  }\\n  # Endpoints\\n  if (dlogy[1] < secants[1] - 1e-10) return(FALSE)\\n  if (dlogy[m] > secants[m-1] + 1e-10) return(FALSE)\\n\\n  TRUE\\n}\\n\\n\\n# ------------------------------------------------------------------------------\\n# Section 4: Envelope Construction (Piecewise Linear Upper Bound)\\n# ------------------------------------------------------------------------------\\n\\n.construct_envelope <- function(xi, logy, dlogy) {\\n  # Build the piecewise-linear upper envelope of log f from the tangent and\\n  # secant lines at the abscissae.  Returns a list with pieces describing each\\n  # linear segment of the envelope.\\n  #\\n  # For interior knots the envelope uses the tangent line; for the two outer\\n  # intervals it uses the tangent line extended.  The intersection points\\n  # between consecutive tangent lines are pre-computed so that each piece is\\n  # a simple affine function on a known interval.\\n\\n  m <- length(xi)\\n  if (m < 2) stop(\\"ars: need at least 2 abscissae to construct an envelope.\\")\\n\\n  # Tangent lines:  L_j(x) = logy[j] + dlogy[j] * (x - xi[j])\\n  # Intersection of tangent j and j+1:\\n  #   logy[j] + dlogy[j]*(x - xi[j]) = logy[j+1] + dlogy[j+1]*(x - xi[j+1])\\n  #   x * (dlogy[j] - dlogy[j+1]) = logy[j+1] - logy[j] - dlogy[j]*xi[j] + dlogy[j+1]*xi[j+1]\\n  #   x = (logy[j+1] - logy[j] - dlogy[j]*xi[j] + dlogy[j+1]*xi[j+1]) /\\n  #       (dlogy[j] - dlogy[j+1])\\n\\n  cuts <- numeric(m - 1)\\n  for (j in 1:(m-1)) {\\n    denom <- dlogy[j] - dlogy[j+1]\\n    if (abs(denom) < 1e-14) {\\n      # Parallel tangents — use midpoint\\n      cuts[j] <- (xi[j] + xi[j+1]) / 2\\n    } else {\\n      num <- logy[j+1] - logy[j] - dlogy[j]*xi[j] + dlogy[j+1]*xi[j+1]\\n      cuts[j] <- num / denom\\n    }\\n  }\\n\\n  # The envelope consists of m-1 linear pieces plus two tail pieces.\\n  # Piece j (1-indexed) is the tangent line at knot j, active on [cuts[j-1], cuts[j]]\\n  # with cuts[0] = -Inf and cuts[m] = +Inf.\\n  list(xi = xi, logy = logy, dlogy = dlogy, cuts = cuts, m = m)\\n}\\n\\n\\n# ------------------------------------------------------------------------------\\n# Section 5: Sampling from the Envelope (Piecewise Exponential Distribution)\\n# ------------------------------------------------------------------------------\\n\\n.sample_from_envelope <- function(env, n, lower, upper) {\\n  # Sample n values from the piecewise exponential distribution defined by\\n  # the upper envelope.  The envelope is a piecewise-linear function in log\\n  # space, so each piece is exponential (or linear if slope = 0).\\n  #\\n  # Returns a numeric vector of length n.\\n\\n  m <- env$m\\n  xi <- env$xi\\n  logy <- env$logy\\n  dlogy <- env$dlogy\\n  cuts <- env$cuts\\n\\n  # Compute the integral (normalization constant) of exp(envelope) over each\\n  # piece, plus the cumulative distribution.\\n  # For a linear piece L(x) = a + b*x on [left, right]:\\n  #   integral = (exp(L(right)) - exp(L(left))) / b   if b != 0\\n  #            = exp(L(left)) * (right - left)        if b == 0\\n  # The envelope value at x for piece j is the tangent at xi[j]:\\n  #   L_j(x) = logy[j] + dlogy[j] * (x - xi[j])\\n\\n  areas <- numeric(m - 1)\\n  # The pieces are: (-Inf, cuts[1]], (cuts[1], cuts[2]], ..., (cuts[m-2], Inf]\\n  # Actually each piece j corresponds to tangent at xi[j], spanning\\n  # (cuts[j-1], cuts[j]) with cuts[0]=-Inf, cuts[m]=+Inf.\\n  # But we have m tangents and m-1 intersection points, giving m pieces\\n  # (two tails + m-2 interior).  Actually the standard ARS has m-1 pieces\\n  # for m points: piece j is between cuts[j-1] and cuts[j] using tangent j,\\n  # with cuts[0] = lower bound and cuts[m] = upper bound.\\n  # Wait - let me reconsider. With m knots there are m-1 interior intersection\\n  # points, producing m pieces: (-Inf, c1], (c1, c2], ..., (c_{m-1}, Inf].\\n  # Piece j uses tangent at xi[j].\\n\\n  # Truncate tails to [lower, upper]\\n  left_bounds <- c(-Inf, cuts)\\n  right_bounds <- c(cuts, Inf)\\n\\n  areas <- numeric(m)\\n  for (j in 1:m) {\\n    left <- max(left_bounds[j], lower)\\n    right <- min(right_bounds[j], upper)\\n    if (left >= right) {\\n      areas[j] <- 0\\n      next\\n    }\\n    b <- dlogy[j]\\n    if (abs(b) < 1e-14) {\\n      # Flat piece\\n      a <- logy[j] - b * xi[j]  # intercept\\n      areas[j] <- exp(a + b * left) * (right - left)\\n    } else {\\n      a <- logy[j] - b * xi[j]\\n      val_left <- exp(a + b * left)\\n      val_right <- exp(a + b * right)\\n      areas[j] <- (val_right - val_left) / b\\n    }\\n    if (is.na(areas[j]) || is.infinite(areas[j]) || areas[j] <= 0) {\\n      areas[j] <- 0\\n    }\\n  }\\n\\n  total <- sum(areas)\\n  if (total <= 0 || is.nan(total)) {\\n    stop(\\"ars: envelope has zero or negative total area — cannot sample.\\")\\n  }\\n\\n  # CDF at piece boundaries\\n  cum_areas <- cumsum(areas)\\n  probs <- cum_areas / total  # cumulative probabilities\\n\\n  # Sample piece indices\\n  u <- runif(n)\\n  piece_idx <- sapply(u, function(ut) {\\n    # Find first index where probs >= ut\\n    which(ut <= probs)[1]\\n  })\\n\\n  # Sample within each piece using inverse transform\\n  samples <- numeric(n)\\n  for (k in 1:n) {\\n    j <- piece_idx[k]\\n    left <- max(left_bounds[j], lower)\\n    right <- min(right_bounds[j], upper)\\n    if (left >= right) {\\n      samples[k] <- NA_real_\\n      next\\n    }\\n    p_low <- if (j == 1) 0 else probs[j-1]\\n    p_high <- probs[j]\\n    # Rescale u to [p_low, p_high]\\n    up <- p_low + u[k] * (p_high - p_low)\\n    # Within piece j, the CDF of the exponential piece:\\n    # F(x) = (exp(a+b*x) - exp(a+b*left)) / (exp(a+b*right) - exp(a+b*left))\\n    # Inverting: x = (1/b) * log( exp(a+b*left) + v*(exp(a+b*right)-exp(a+b*left)) ) - a/b\\n    b <- dlogy[j]\\n    a <- logy[j] - b * xi[j]\\n    v <- (up - p_low) / (p_high - p_low)\\n    if (abs(b) < 1e-14) {\\n      # Linear (flat) case\\n      samples[k] <- left + v * (right - left)\\n    } else {\\n      exp_left <- exp(a + b * left)\\n      exp_right <- exp(a + b * right)\\n      inner <- exp_left + v * (exp_right - exp_left)\\n      if (inner <= 0 || is.nan(inner)) {\\n        samples[k] <- NA_real_\\n      } else {\\n        samples[k] <- (log(inner) - a) / b\\n      }\\n    }\\n  }\\n\\n  samples\\n}\\n\\n\\n# ------------------------------------------------------------------------------\\n# Section 6: Core ARS Sampler\\n# ------------------------------------------------------------------------------\\n\\n.ars_core <- function(params) {\\n  n <- params$n\\n  logdens <- params$logdens\\n  lower <- params$lower\\n  upper <- params$upper\\n  xini <- params$xini\\n  verbose <- params$verbose\\n\\n  # Initial evaluation\\n  xi <- xini\\n  logy <- .evaluate_logdens(logdens, xi)\\n  dlogy <- .compute_derivatives(logdens, xi)\\n\\n  if (verbose) {\\n    cat(\\"Initial abscissae:\\", paste(xi, collapse = \\", \\"), \\"\\\\n\\")\\n    cat(\\"Log-density values:\\", paste(round(logy, 4), collapse = \\", \\"), \\"\\\\n\\")\\n    cat(\\"Derivatives:\\", paste(round(dlogy, 4), collapse = \\", \\"), \\"\\\\n\\")\\n  }\\n\\n  # Check log-concavity of initial configuration\\n  if (!.check_log_concavity(xi, logy, dlogy)) {\\n    stop(\\"ars: initial abscissae do not satisfy log-concavity conditions. \\",\\n         \\"The target log-density may not be concave, or initial points are poorly placed.\\")\\n  }\\n\\n  env <- .construct_envelope(xi, logy, dlogy)\\n  samples <- numeric(n)\\n  accepted <- 0\\n  rejected <- 0\\n  max_iter <- n * 100  # safeguard against infinite loops\\n\\n  while (accepted < n && rejected + accepted < max_iter) {\\n    # Propose from envelope\\n    u_prop <- .sample_from_envelope(env, 1, lower, upper)\\n\\n    # Evaluate true log-density at proposal\\n    log_y_true <- logdens(u_prop)\\n\\n    # Rejection step: accept with probability exp(log_f(u) - envelope(u))\\n    # Envelope value at u: find which piece it falls in and evaluate the\\n    # corresponding tangent/secant line.\\n    m <- env$m\\n    cuts <- env$cuts\\n    envelope_val <- -Inf\\n    for (j in 1:m) {\\n      left_b <- if (j == 1) lower else cuts[j-1]\\n      right_b <- if (j == m) upper else cuts[j]\\n      if (u_prop >= left_b && u_prop < right_b) {\\n        # Tangent at xi[j]\\n        envelope_val <- env$logy[j] + env$dlogy[j] * (u_prop - env$xi[j])\\n        break\\n      }\\n    }\\n    # Fallback: if on boundary, use nearest\\n    if (is.infinite(envelope_val)) {\\n      j <- which.min(abs(env$xi - u_prop))\\n      envelope_val <- env$logy[j] + env$dlogy[j] * (u_prop - env$xi[j])\\n    }\\n\\n    # Acceptance probability\\n    log_alpha <- log_y_true - envelope_val\\n    if (log_alpha > 0) log_alpha <- 0  # numerical safeguard\\n\\n    u_unif <- runif(1)\\n    if (is.nan(u_unif)) u_unif <- 0\\n\\n    if (log(u_unif) <= log_alpha) {\\n      # Accept\\n      accepted <- accepted + 1\\n      samples[accepted] <- u_prop\\n\\n      # Adaptive step: add the accepted point to the abscissae and rebuild envelope\\n      new_x <- u_prop\\n      new_logy <- logdens(new_x)\\n      new_dlogy <- .compute_derivatives(logdens, new_x)\\n\\n      # Insert new point in sorted order\\n      pos <- sum(xi <= new_x) + 1\\n      xi <- c(xi[1:(pos-1)], new_x, xi[pos:m])\\n      logy <- c(logy[1:(pos-1)], new_logy, logy[pos:m])\\n      dlogy <- c(dlogy[1:(pos-1)], new_dlogy, dlogy[pos:m])\\n\\n      # Check log-concavity after insertion\\n      if (!.check_log_concavity(xi, logy, dlogy)) {\\n        stop(\\"ars: log-concavity violated after accepting a sample point. \\",\\n             \\"The target density is not log-concave.\\")\\n      }\\n\\n      env <- .construct_envelope(xi, logy, dlogy)\\n\\n      if (verbose) {\\n        cat(sprintf(\\"  Accepted x=%.6f (now %d/%d samples, %d abscissae)\\\\n\\",\\n                    new_x, accepted, n, length(xi)))\\n      }\\n    } else {\\n      # Reject: still add the point to improve the envelope\\n      rejected <- rejected + 1\\n      new_x <- u_prop\\n      new_logy <- logdens(new_x)\\n      new_dlogy <- .compute_derivatives(logdens, new_x)\\n\\n      pos <- sum(xi <= new_x) + 1\\n      xi <- c(xi[1:(pos-1)], new_x, xi[pos:m])\\n      logy <- c(logy[1:(pos-1)], new_logy, logy[pos:m])\\n      dlogy <- c(dlogy[1:(pos-1)], new_dlogy, dlogy[pos:m])\\n\\n      # Check log-concavity after insertion\\n      if (!.check_log_concavity(xi, logy, dlogy)) {\\n        stop(\\"ars: log-concavity violated after rejecting a sample point. \\",\\n             \\"The target density is not log-concave.\\")\\n      }\\n\\n      env <- .construct_envelope(xi, logy, dlogy)\\n    }\\n  }\\n\\n  if (accepted < n) {\\n    warning(\\"ars: could not generate all \\", n, \\" samples. \\",\\n            \\"Generated \\", accepted, \\" before reaching iteration limit.\\")\\n    samples <- samples[1:accepted]\\n  }\\n\\n  samples\\n}\\n\\n\\n# ------------------------------------------------------------------------------\\n# Section 7: Public Interface\\n# ------------------------------------------------------------------------------\\n\\nars <- function(n, logdens, lower = -Inf, upper = Inf, xini = NULL, verbose = FALSE) {\\n  # Adaptive Rejection Sampler (Gilks & Wild, 1992)\\n  #\\n  # Parameters\\n  # ----------\\n  # n       : integer, number of samples to generate.\\n  # logdens : function, the log of the (possibly unnormalized) target density.\\n  #           Must accept a numeric vector and return a numeric vector of\\n  #           the same length.\\n  # lower   : numeric, lower bound of the support (default: -Inf).\\n  # upper   : numeric, upper bound of the support (default: +Inf).\\n  # xini    : numeric vector of >= 3 initial abscissae inside (lower, upper).\\n  #           If NULL, defaults to three evenly-spaced points.\\n  # verbose : logical, whether to print diagnostic output.\\n  #\\n  # Returns\\n  # -------\\n  # A numeric vector of length n containing independent samples from the\\n  # target distribution.\\n  #\\n  # Notes\\n  # -----\\n  # The target log-density must be concave (i.e., the density must be\\n  # log-concave).  The algorithm will detect violations during sampling and\\n  # throw an error.\\n\\n  params <- .validate_inputs(n, logdens, lower, upper, xini, verbose)\\n  result <- .ars_core(params)\\n  class(result) <- \\"ars_sample\\"\\n  result\\n}\\n\\n\\n# ------------------------------------------------------------------------------\\n# Section 8: Test Suite\\n# ------------------------------------------------------------------------------\\n\\ntest <- function() {\\n  # Formal test suite for the adaptive rejection sampler.\\n  # Runs several tests against known distributions and reports PASS/FAIL.\\n  #\\n  # Each test prints a descriptive message and either \\"TEST_NAME: PASS\\" or\\n  # \\"TEST_NAME: FAIL\\" together with summary statistics.\\n\\n  passed <- 0\\n  failed <- 0\\n\\n  # -------------------------------------------------------------------------\\n  # Helper: run one test and accumulate results\\n  # -------------------------------------------------------------------------\\n  run_test <- function(name, expr) {\\n    cat(\\"\\\\n=== \\", name, \\" ===\\\\n\\", sep = \\"\\")\\n    result <- tryCatch({\\n      expr\\n      \\"PASS\\"\\n    }, error = function(e) {\\n      cat(\\"  ERROR:\\", e$message, \\"\\\\n\\")\\n      \\"FAIL\\"\\n    })\\n    if (result == \\"PASS\\") {\\n      cat(name, \\": PASS\\\\n\\")\\n      passed <<- passed + 1\\n    } else {\\n      cat(name, \\": FAIL\\\\n\\")\\n      failed <<- failed + 1\\n    }\\n  }\\n\\n  # -------------------------------------------------------------------------\\n  # Test 1: Basic normal sampling — mean and sd close to target\\n  # -------------------------------------------------------------------------\\n  run_test(\\"NORMAL_MEAN_SD\\", {\\n    set.seed(42)\\n    n <- 5000\\n    samples <- ars(n, logdens = function(x) dnorm(x, mean = 0, sd = 1, log = TRUE),\\n                   lower = -10, upper = 10, verbose = FALSE)\\n    cat(sprintf(\\"  Generated %d samples\\\\n\\", length(samples)))\\n    cat(sprintf(\\"  Sample mean:     %.4f  (target: 0.0000)\\\\n\\", mean(samples)))\\n    cat(sprintf(\\"  Sample sd:       %.4f  (target: 1.0000)\\\\n\\", sd(samples)))\\n    # Tolerance: mean within 0.1, sd within 0.15\\n    stopifnot(abs(mean(samples) - 0) < 0.15)\\n    stopifnot(abs(sd(samples) - 1) < 0.20)\\n  })\\n\\n  # -------------------------------------------------------------------------\\n  # Test 2: Exponential sampling — compare to known mean and sd\\n  # -------------------------------------------------------------------------\\n  run_test(\\"EXPONENTIAL_MEAN_SD\\", {\\n    set.seed(123)\\n    n <- 5000\\n    lambda <- 2\\n    samples <- ars(n, logdens = function(x) dexp(x, rate = lambda, log = TRUE),\\n                   lower = 0, upper = 20, verbose = FALSE)\\n    cat(sprintf(\\"  Generated %d samples\\\\n\\", length(samples)))\\n    cat(sprintf(\\"  Sample mean:     %.4f  (target: %.4f)\\\\n\\", mean(samples), 1/lambda))\\n    cat(sprintf(\\"  Sample sd:       %.4f  (target: %.4f)\\\\n\\", sd(samples), 1/lambda))\\n    stopifnot(abs(mean(samples) - 1/lambda) < 0.15)\\n    stopifnot(abs(sd(samples) - 1/lambda) < 0.20)\\n    # Save to file\\n    writeLines(as.character(samples), \\"/app/exponential_samples.txt\\")\\n    cat(\\"  Saved exponential samples to /app/exponential_samples.txt\\\\n\\")\\n  })\\n\\n  # -------------------------------------------------------------------------\\n  # Test 3: Normal samples saved to file\\n  # -------------------------------------------------------------------------\\n  run_test(\\"NORMAL_SAMPLES_SAVED\\", {\\n    set.seed(7)\\n    n <- 5000\\n    samples <- ars(n, logdens = function(x) dnorm(x, mean = 0, sd = 1, log = TRUE),\\n                   lower = -10, upper = 10, verbose = FALSE)\\n    writeLines(as.character(samples), \\"/app/normal_samples.txt\\")\\n    cat(sprintf(\\"  Saved %d normal samples to /app/normal_samples.txt\\\\n\\", length(samples)))\\n    stopifnot(length(samples) == n)\\n  })\\n\\n  # -------------------------------------------------------------------------\\n  # Test 4: Input validation — negative n\\n  # -------------------------------------------------------------------------\\n  run_test(\\"INPUT_NEGATIVE_N\\", {\\n    err <- tryCatch({\\n      ars(-1, logdens = dnorm, lower = -10, upper = 10, log = TRUE)\\n      \\"no_error\\"\\n    }, error = function(e) e$message)\\n    stopifnot(err != \\"no_error\\")\\n    cat(\\"  Correctly rejected negative n\\\\n\\")\\n  })\\n\\n  # -------------------------------------------------------------------------\\n  # Test 5: Input validation — non-function logdens\\n  # -------------------------------------------------------------------------\\n  run_test(\\"INPUT_NON_FUNCTION_LOGDENS\\", {\\n    err <- tryCatch({\\n      ars(10, logdens = \\"not_a_function\\", lower = -10, upper = 10)\\n      \\"no_error\\"\\n    }, error = function(e) e$message)\\n    stopifnot(err != \\"no_error\\")\\n    cat(\\"  Correctly rejected non-function logdens\\\\n\\")\\n  })\\n\\n  # -------------------------------------------------------------------------\\n  # Test 6: Input validation — invalid domain (lower >= upper)\\n  # -------------------------------------------------------------------------\\n  run_test(\\"INPUT_INVALID_DOMAIN\\", {\\n    err <- tryCatch({\\n      ars(10, logdens = dnorm, lower = 5, upper = 2)\\n      \\"no_error\\"\\n    }, error = function(e) e$message)\\n    stopifnot(err != \\"no_error\\")\\n    cat(\\"  Correctly rejected invalid domain\\\\n\\")\\n  })\\n\\n  # -------------------------------------------------------------------------\\n  # Test 7: Non-log-concave density — should error\\n  # -------------------------------------------------------------------------\\n  run_test(\\"NON_LOG_CONCAVE_REJECTED\\", {\\n    # Bimodal mixture: not log-concave\\n    bad_logdens <- function(x) log(0.5 * dnorm(x, -2, 0.5) + 0.5 * dnorm(x, 2, 0.5))\\n    err <- tryCatch({\\n      set.seed(99)\\n      ars(100, logdens = bad_logdens, lower = -6, upper = 6,\\n          xini = c(-4, 0, 4))\\n      \\"no_error\\"\\n    }, error = function(e) e$message)\\n    stopifnot(err != \\"no_error\\")\\n    cat(\\"  Correctly detected non-log-concave density\\\\n\\")\\n  })\\n\\n  # -------------------------------------------------------------------------\\n  # Test 8: Normal quantile-quantile against theoretical CDF\\n  # -------------------------------------------------------------------------\\n  run_test(\\"NORMAL_QQ_KS\\", {\\n    set.seed(2024)\\n    n <- 3000\\n    samples <- ars(n, logdens = function(x) dnorm(x, mean = 0, sd = 1, log = TRUE),\\n                   lower = -8, upper = 8, verbose = FALSE)\\n    ks_result <- ks.test(samples, \\"pnorm\\", mean = 0, sd = 1)\\n    cat(sprintf(\\"  KS statistic: %.4f, p-value: %.4f\\\\n\\",\\n                ks_result$statistic, ks_result$p.value))\\n    # At 5% level, p-value should be > 0.01 for a good fit\\n    stopifnot(ks_result$p.value > 0.01)\\n  })\\n\\n  # -------------------------------------------------------------------------\\n  # Test 9: Exponential KS test\\n  # -------------------------------------------------------------------------\\n  run_test(\\"EXPONENTIAL_KS\\", {\\n    set.seed(2025)\\n    n <- 3000\\n    lambda <- 1.5\\n    samples <- ars(n, logdens = function(x) dexp(x, rate = lambda, log = TRUE),\\n                   lower = 0, upper = 15, verbose = FALSE)\\n    ks_result <- ks.test(samples, \\"pexp\\", rate = lambda)\\n    cat(sprintf(\\"  KS statistic: %.4f, p-value: %.4f\\\\n\\",\\n                ks_result$statistic, ks_result$p.value))\\n    stopifnot(ks_result$p.value > 0.01)\\n  })\\n\\n  # -------------------------------------------------------------------------\\n  # Test 10: Custom log-concave density — Gamma(3,1)\\n  # -------------------------------------------------------------------------\\n  run_test(\\"GAMMA_SAMPLES\\", {\\n    set.seed(33)\\n    n <- 4000\\n    # Gamma(3,1): log f(x) = 2*log(x) - x  (up to constants)\\n    samples <- ars(n, logdens = function(x) (3 - 1) * log(x) - x,\\n                   lower = 0.001, upper = 20, verbose = FALSE)\\n    cat(sprintf(\\"  Generated %d samples\\\\n\\", length(samples)))\\n    cat(sprintf(\\"  Sample mean:     %.4f  (target: %.4f)\\\\n\\",\\n                mean(samples), 3/1))\\n    cat(sprintf(\\"  Sample sd:       %.4f  (target: %.4f)\\\\n\\",\\n                sd(samples), sqrt(3)/1))\\n    stopifnot(abs(mean(samples) - 3) < 0.15)\\n    stopifnot(abs(sd(samples) - sqrt(3)) < 0.25)\\n  })\\n\\n  # -------------------------------------------------------------------------\\n  # Summary\\n  # -------------------------------------------------------------------------\\n  cat(\\"\\\\n========== TEST SUMMARY ==========\\\\n\\")\\n  cat(sprintf(\\"Passed: %d / %d\\\\n\\", passed, passed + failed))\\n  cat(sprintf(\\"Failed: %d / %d\\\\n\\", failed, passed + failed))\\n  if (failed > 0) {\\n    cat(\\"SOME TESTS FAILED!\\\\n\\")\\n  } else {\\n    cat(\\"ALL TESTS PASSED!\\\\n\\")\\n  }\\n  invisible(list(passed = passed, failed = failed))\\n}\\n"'}}]
