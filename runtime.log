[agent-runtime] llm.chunk iteration=10 content='' reasoning='' tool_calls=[{'index': 1, 'id': None, 'function': {'name': None, 'arguments': '"content": "#\' Test suite for adaptive rejection sampling (ARS)\\n#\'\\n#\' Runs formal tests against known distributions (Normal, Exponential, Gamma)\\n#\' and reports results in a clear PASS/FAIL format with descriptive statistics.\\n#\'\\n#\' @param n_samples Number of samples to draw for each test distribution.\\n#\' @return Invisible NULL (side effects: prints test results, writes sample files).\\ntest <- function(n_samples = 10000) {\\n  source(\\"/app/ars.R\\")\\n\\n  cat(\\"============================================================\\\\n\\")\\n  cat(\\" Adaptive Rejection Sampling — Test Suite\\\\n\\")\\n  cat(\\" Gilks & Wild (1992) Implementation\\\\n\\")\\n  cat(\\"============================================================\\\\n\\\\n\\")\\n\\n  passed  <- 0\\n  failed  <- 0\\n\\n  ## ---- 1. INPUT VALIDATION TESTS ------------------------------------------\\n  cat(\\"1. Input Validation Tests\\\\n\\")\\n  cat(\\"------------------------------------------------------------\\\\n\\")\\n\\n  lognorm <- function(x) -0.5 * x^2\\n  xlow    <- -Inf\\n  xup     <- Inf\\n  x0      <- c(-1, 0, 1)\\n\\n  ## 1a. Negative n\\n  test_input_negative_n <- function() {\\n    tryCatch({\\n      ars(-5, lognorm, xlow, xup, x0)\\n      return(FALSE)\\n    }, error = function(e) grepl(\\"positive integer\\", e$message, ignore.case = TRUE))\\n  }\\n  ok <- test_input_negative_n()\\n  if (ok) { cat(\\"  INPUT_NEGATIVE_N:   PASS\\\\n\\"); passed <- passed + 1 } else { cat(\\"  INPUT_NEGATIVE_N:   FAIL\\\\n\\"); failed <- failed + 1 }\\n\\n  ## 1b. Non-function log-density\\n  test_input_non_func <- function() {\\n    tryCatch({\\n      ars(10, 42, xlow, xup, x0)\\n      return(FALSE)\\n    }, error = function(e) grepl(\\"\'logdens\' must be a function\\", e$message))\\n  }\\n  ok <- test_input_non_func()\\n  if (ok) { cat(\\"  INPUT_NON_FUNC:     PASS\\\\n\\"); passed <- passed + 1 } else { cat(\\"  INPUT_NON_FUNC:     FAIL\\\\n\\"); failed <- failed + 1 }\\n\\n  ## 1c. xlow >= xup\\n  test_input_bounds <- function() {\\n    tryCatch({\\n      ars(10, lognorm, 5, 3, x0)\\n      return(FALSE)\\n    }, error = function(e) grepl(\\"\'xlow\' must be strictly less\\", e$message))\\n  }\\n  ok <- test_input_bounds()\\n  if (ok) { cat(\\"  INPUT_BAD_BOUNDS:   PASS\\\\n\\"); passed <- passed + 1 } else { cat(\\"  INPUT_BAD_BOUNDS:   FAIL\\\\n\\"); failed <- failed + 1 }\\n\\n  ## 1d. Too few initial abscissae\\n  test_input_few_x0 <- function() {\\n    tryCatch({\\n      ars(10, lognorm, xlow, xup, c(0, 1))\\n      return(FALSE)\\n    }, error = function(e) grepl(\\"at least 3 points\\", e$message))\\n  }\\n  ok <- test_input_few_x0()\\n  if (ok) { cat(\\"  INPUT_FEW_X0:       PASS\\\\n\\"); passed <- passed + 1 } else { cat(\\"  INPUT_FEW_X0:       FAIL\\\\n\\"); failed <- failed + 1 }\\n\\n  ## 1e. Initial abscissae outside domain\\n  test_input_x0_outside <- function() {\\n    tryCatch({\\n      ars(10, lognorm, 0, 10, c(-1, 0, 1))\\n      return(FALSE)\\n    }, error = function(e) grepl(\\"strictly inside\\", e$message))\\n  }\\n  ok <- test_input_x0_outside()\\n  if (ok) { cat(\\"  INPUT_X0_OUTSIDE:   PASS\\\\n\\"); passed <- passed + 1 } else { cat(\\"  INPUT_X0_OUTSIDE:   FAIL\\\\n\\"); failed <- failed + 1 }\\n\\n  cat(\\"\\\\n\\")\\n\\n  ## ---- 2. NON-LOG-CONCAVE DENSITY TEST ------------------------------------\\n  cat(\\"2. Log-Concavity Check\\\\n\\")\\n  cat(\\"------------------------------------------------------------\\\\n\\")\\n\\n  bimodal_logdens <- function(x) log(dnorm(x, mean = -3) + dnorm(x, mean = 3))\\n  tryCatch({\\n    ars(100, bimodal_logdens, -Inf, Inf, c(-5, 0, 5))\\n    cat(\\"  NON_LOG_CONCAVE:  FAIL (no error thrown)\\\\n\\")\\n    failed <- failed + 1\\n  }, error = function(e) {\\n    if (grepl(\\"Log-concavity violated\\", e$message, ignore.case = TRUE)) {\\n      cat(\\"  NON_LOG_CONCAVE:  PASS\\\\n\\")\\n      passed <- passed + 1\\n    } else {\\n      cat(\\"  NON_LOG_CONCAVE:  FAIL (unexpected error)\\\\n\\")\\n      failed <- failed + 1\\n    }\\n  })\\n  cat(\\"\\\\n\\")\\n\\n  ## ---- 3. DISTRIBUTIONAL TESTS --------------------------------------------\\n  cat(\\"3. Distributional Tests\\\\n\\")\\n  cat(\\"------------------------------------------------------------\\\\n\\")\\n\\n  ## 3a. Standard Normal -------------------------------------------------------\\n  cat(\\"  [Normal] Generating \\", n_samples, \\" samples ... \\\\n\\")\\n  set.seed(42)\\n  normal_samples <- ars(n_samples,\\n                         logdens = function(x) -0.5 * x^2,\\n                         xlow    = -Inf, xup = Inf,\\n                         x0      = c(-2, 0, 2))\\n  writeLines(as.character(normal_samples), \\"/app/normal_samples.txt\\")\\n  m  <- mean(normal_samples)\\n  sd_v <- sd(normal_samples)\\n  cat(\\"    Mean         : \\", round(m, 4), \\"  (target 0)\\\\n\\")\\n  cat(\\"    Std Dev      : \\", round(sd_v, 4), \\"  (target 1)\\\\n\\")\\n  if (.ks_test(normal_samples, pnorm, alpha = 0.01)) {\\n    cat(\\"  NORMAL: PASS\\\\n\\\\n\\")\\n    passed <- passed + 1\\n  } else {\\n    cat(\\"  NORMAL: FAIL\\\\n\\\\n\\")\\n    failed <- failed + 1\\n  }\\n\\n  ## 3b. Exponential -----------------------------------------------------------\\n  cat(\\"  [Exponential] Generating \\", n_samples, \\" samples ... \\\\n\\")\\n  set.seed(123)\\n  exp_samples <- ars(n_samples,\\n                     logdens = function(x) -x,\\n                     xlow    = 0, xup = Inf,\\n                     x0      = c(0.1, 1, 3))\\n  writeLines(as.character(exp_samples), \\"/app/exponential_samples.txt\\")\\n  m  <- mean(exp_samples)\\n  sd_v <- sd(exp_samples)\\n  cat(\\"    Mean         : \\", round(m, 4), \\"  (target 1)\\\\n\\")\\n  cat(\\"    Std Dev      : \\", round(sd_v, 4), \\"  (target 1)\\\\n\\")\\n  if (.ks_test(exp_samples, pexp, alpha = 0.01)) {\\n    cat(\\"  EXPONENTIAL: PASS\\\\n\\\\n\\")\\n    passed <- passed + 1\\n  } else {\\n    cat(\\"  EXPONENTIAL: FAIL\\\\n\\\\n\\")\\n    failed <- failed + 1\\n  }\\n\\n  ## 3c. Gamma(2,1) ------------------------------------------------------------\\n  cat(\\"  [Gamma(2,1)] Generating \\", n_samples, \\" samples ... \\\\n\\")\\n  set.seed(456)\\n  gamma_samples <- ars(n_samples,\\n                       logdens = function(x) (2 - 1) * log(x) - x,\\n                       xlow    = 0, xup = Inf,\\n                       x0      = c(0.2, 1, 3))\\n  m  <- mean(gamma_samples)\\n  sd_v <- sd(gamma_samples)\\n  cat(\\"    Mean         : \\", round(m, 4), \\"  (target 2)\\\\n\\")\\n  cat(\\"    Std Dev      : \\", round(sd_v, 4), \\"  (target sqrt(2))\\\\n\\")\\n  if (.ks_test(gamma_samples, pgamma, alpha = 0.01, shape = 2, rate = 1)) {\\n    cat(\\"  GAMMA: PASS\\\\n\\\\n\\")\\n    passed <- passed + 1\\n  } else {\\n    cat(\\"  GAMMA: FAIL\\\\n\\\\n\\")\\n    failed <- failed + 1\\n  }\\n\\n  ## 3d. Cauchy (log-concave, heavy-tailed) ------------------------------------\\n  cat(\\"  [Cauchy] Generating \\", n_samples, \\" samples ... \\\\n\\")\\n  set.seed(789)\\n  cauchy_samples <- ars(n_samples,\\n                        logdens = function(x) -log(1 + x^2),\\n                        xlow    = -Inf, xup = Inf,\\n                        x0      = c(-2, 0, 2))\\n  m  <- mean(cauchy_samples)\\n  sd_v <- sd(cauchy_samples)\\n  cat(\\"    Mean         : \\", round(m, 4), \\"  (undefined for Cauchy)\\\\n\\")\\n  cat(\\"    Std Dev      : \\", round(sd_v, 4), \\"  (undefined for Cauchy)\\\\n\\")\\n  if (.ks_test(cauchy_samples, pcauchy, alpha = 0.01)) {\\n    cat(\\"  CAUCHY: PASS\\\\n\\\\n\\")\\n    passed <- passed + 1\\n  } else {\\n    cat(\\"  CAUCHY: FAIL\\\\n\\\\n\\")\\n    failed <- failed + 1\\n  }\\n\\n  ## 3e. Log-Normal(0,1) ------------------------------------------------------\\n  cat(\\"  [LogNormal] Generating \\", n_samples, \\" samples ... \\\\n\\")\\n  set.seed(111)\\n  lnorm_samples <- ars(n_samples,\\n                       logdens = function(x) -0.5 * (log(x))^2 - log(x),\\n                       xlow    = 0, xup = Inf,\\n                       x0      = c(0.1, 1, 5))\\n  m  <- mean(lnorm_samples)\\n  sd_v <- sd(lnorm_samples)\\n  cat(\\"    Mean         : \\", round(m, 4), \\"  (target \\", round(exp(0.5), 4), \\")\\\\n\\")\\n  cat(\\"    Std Dev      : \\", round(sd_v, 4), \\"  (target \\", round(sqrt(exp(1)-1)*exp(0.5), 4), \\")\\\\n\\")\\n  if (.ks_test(lnorm_samples, plnorm, alpha = 0.01)) {\\n    cat(\\"  LOGNORMAL: PASS\\\\n\\\\n\\")\\n    passed <- passed + 1\\n  } else {\\n    cat(\\"  LOGNORMAL: FAIL\\\\n\\\\n\\")\\n    failed <- failed + 1\\n  }\\n\\n  ## ---- 4. SUMMARY -----------------------------------------------------------\\n  cat(\\"============================================================\\\\n\\")\\n  cat(\\" Summary: \\", passed, \\" passed, \\", failed, \\" failed\\\\n\\")\\n  cat(\\"============================================================\\\\n\\")\\n\\n  invisible(list(passed = passed, failed = failed))\\n}\\n\\n## ---- helper: KS goodness-of-fit test vs theoretical CDF --------------------\\n.ks_test <- function(samples, pfun, alpha = 0.05, ...) {\\n  ks_res <- ks.test(samples, pfun, ...)\\n  sig <- ks_res$p.value < alpha\\n  direction <- ifelse(sig, \\"reject H0\\", \\"fail to reject H0\\")\\n  cat(\\"    KS statistic : \\", round(ks_res$statistic, 4),\\n      \\", p-value      : \\", format(ks_res$p.value, scientific = FALSE),\\n      \\" -> \\", direction, \\"\\\\n\\", sep = \\"\\")\\n  return(!sig)\\n}\\n"'}}]
